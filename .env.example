# --- PostgreSQL ---
POSTGRES_DB=GUAP_Messenger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# --- RabbitMQ ---
RABBITMQ_USER=messenger
RABBITMQ_PASSWORD=CHANGE_ME

# --- Публичный адрес API (HTTPS, через nginx). Заполнить когда будет домен ---
URL__API__HTTPS=https://CHANGE_ME

# --- Keycloak / OIDC (client "messager" в realm master на sso.guap.ru) ---
AzureAd__ClientId=messager
AzureAd__ClientSecret=CHANGE_ME
AzureAd__CallbackPath=/signin-oidc
AzureAd__SignedOutCallbackPath=/signout-callback-oidc

# --- AES (base64 ключ) ---
Encryption__MasterKeyBase64=CHANGE_ME

# --- VAPID (web-push). Сгенерировать ключи ---
Vapid__Subject=mailto:admin@guap.ru
Vapid__PublicKey=CHANGE_ME
Vapid__PrivateKey=CHANGE_ME
