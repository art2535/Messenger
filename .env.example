# ==============================================================================
# GUAP Messenger - Production & Development Environment
# Скопируйте в .env и заполните реальные значения. НЕ коммитьте в Git!
# ==============================================================================

# --- PostgreSQL ---
POSTGRES_DB=GUAP_Messenger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- RabbitMQ ---
RABBITMQ_USER=messenger
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Публичный адрес API (HTTPS, через nginx) ---
URL__API__HTTPS=https://CHANGE_ME_DOMAIN

# --- Keycloak / OIDC (client "messager" в realm master на sso.guap.ru) ---
AzureAd__Instance=https://sso.guap.ru/realms/
AzureAd__TenantId=master
AzureAd__ClientId=messager
AzureAd__Audience=messager
AzureAd__ClientSecret=CHANGE_ME_CLIENT_SECRET
AzureAd__CallbackPath=/signin-oidc
AzureAd__SignedOutCallbackPath=/signout-callback-oidc

# --- AES Шифрование (base64 ключ, ровно 32 байта в раскодированном виде) ---
Encryption__MasterKeyBase64=CHANGE_ME_BASE64_32_BYTES_KEY

# --- VAPID (Web Push). Сгенерировать ключи ---
Vapid__Subject=mailto:admin@guap.ru
Vapid__PublicKey=CHANGE_ME_VAPID_PUBLIC_KEY
Vapid__PrivateKey=CHANGE_ME_VAPID_PRIVATE_KEY

# --- Метрики и безопасность ---
# Задать одинаковые значения здесь и в monitoring/prometheus.yml (basic_auth)
MetricsAuth__Username=prometheus
MetricsAuth__Password=CHANGE_ME_STRONG_PASSWORD

# --- Опционально: Настройки портов для Aspire Dashboard (локальная разработка) ---
Ports__RabbitMQManagement=15672
Ports__RabbitMQExporter=9419
Ports__RedisExporter=9121
Ports__Prometheus=9090
Ports__Grafana=3000
Ports__API__HTTPS=7001
Ports__API__HTTP=5245
Ports__Web__HTTPS=7010
Ports__Web__HTTP=5207