{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Memory Usage (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "dotnet_process_memory_working_set_bytes / 1024 / 1024",
          "legendFormat": "Working Set"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "nullValueMode": "asZero",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 256 },
              { "color": "red", "value": 512 }
            ]
          }
        }
      }
    },
    {
      "title": "CPU Usage (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(dotnet_process_cpu_time_seconds_total[1m]) * 100",
          "legendFormat": "{{cpu_mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "nullValueMode": "asZero"
        }
      }
    },
    {
      "title": "HTTP Requests/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count[1m])) or vector(0)",
          "legendFormat": "RPS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "nullValueMode": "asZero"
        }
      }
    },
    {
      "title": "HTTP 95th Percentile Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[5m])) by (le)) or vector(0)",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "nullValueMode": "asZero"
        }
      }
    },
    {
      "title": "HTTP Errors (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "5xx errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "nullValueMode": "asZero",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "title": "GC Collections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(dotnet_gc_collections_total[5m]) or vector(0)",
          "legendFormat": "{{gc_heap_generation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "nullValueMode": "asZero"
        }
      }
    },
    {
      "title": "Thread Pool Threads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "dotnet_thread_pool_thread_count_total or vector(0)",
          "legendFormat": "Threads"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "nullValueMode": "asZero"
        }
      }
    },
    {
      "title": "Exceptions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "rate(dotnet_exceptions_total[5m]) or vector(0)",
          "legendFormat": "{{error_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "nullValueMode": "asZero"
        }
      }
    },
    {
      "title": "EF Core Queries/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "rate(microsoft_entityframeworkcore_queries_total[1m]) or vector(0)",
          "legendFormat": "Queries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "nullValueMode": "asZero"
        }
      }
    },
    {
      "title": "Kestrel Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "kestrel_active_connections or vector(0)",
          "legendFormat": "Connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "nullValueMode": "asZero"
        }
      }
    }
  ],
