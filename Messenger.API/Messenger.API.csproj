<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>7622b6b5-a2b7-4087-949d-150fe4e6e123</UserSecretsId>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
		<PackageReference Include="MassTransit" Version="8.5.8" />
		<PackageReference Include="MassTransit.EntityFrameworkCore" Version="8.5.8" />
		<PackageReference Include="MassTransit.RabbitMQ" Version="8.5.8" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
		<PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
		<PackageReference Include="Scalar.AspNetCore" Version="2.17.6" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Messenger.Core\Messenger.Core.csproj" />
		<ProjectReference Include="..\Messenger.Infrastructure\Messenger.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="wwwroot\uploads\" />
		<Folder Include="wwwroot\avatars\" />
	</ItemGroup>

</Project>