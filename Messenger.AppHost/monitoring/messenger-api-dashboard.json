        {
          "expr": "rate(dotnet_process_cpu_time_seconds_total[1m]) * 100",
          "legendFormat": "{{cpu_mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "nullValueMode": "asZero"
        }
      }
    },
