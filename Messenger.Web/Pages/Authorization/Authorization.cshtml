@page
@using System.Text.Json;
@model Messenger.Web.Pages.Authorization.AuthorizationModel
@{
    ViewData["Title"] = "Вход в систему";
    Layout = "_Layout";
}

<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
<script src="https://unpkg.com/feather-icons"></script>
<partial name="_LayoutPWA" />
<link rel="stylesheet" href="~/css/authorization.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/ui-dialogs.css" asp-append-version="true" />


<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo-wrap">
            <img src="~/images/logo.png" alt="GUAP Messenger" />
        </div>
        <h1>GUAP Messenger</h1>
        <p class="auth-subtitle">Войдите через систему ЕТА ГУАП</p>

        <a href="/Authorization/Authorization?handler=EtaLogin" class="auth-login-btn">
            <i data-feather="log-in"></i>
            <span>Войти через ЕТА ГУАП</span>
        </a>

        <p class="auth-hint">Используйте корпоративную учётную запись ГУАП</p>
    </div>
</div>

<script>
    // После выхода очищаем клиентский token, чтобы session-cleanup и SignalR не слали запросы
    (function () {
        try {
            const params = new URLSearchParams(window.location.search);
            if (params.get('loggedOut') === 'true' || params.get('loggedOut') === 'True') {
                localStorage.removeItem('token');
            }
        } catch (e) { }
    })();
    window.AUTH_ERRORS = [];
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <text>window.AUTH_ERRORS.push(@Html.Raw(JsonSerializer.Serialize(Model.ErrorMessage)));</text>
    }
    @foreach (var key in ViewData.ModelState.Keys)
    {
        var state = ViewData.ModelState[key];
        foreach (var error in state.Errors)
        {
            <text>window.AUTH_ERRORS.push(@Html.Raw(JsonSerializer.Serialize(error.ErrorMessage)));</text>
        }
    }
</script>
<script src="~/js/ui-dialogs.js" asp-append-version="true"></script>
<script src="~/js/authorization.js" asp-append-version="true"></script>