@page
@model PrivacyModel
@{
    ViewData["Title"] = "Политика конфиденциальности";
    Layout = "_Layout";
}

<style>
    :root {
        --guap-blue: #005aaa;
        --guap-blue-dark: #004a8f;
        --guap-cyan: #00b8ee;
        --guap-purple: #ab3a8d;
        --guap-gradient: linear-gradient(135deg, #005aaa 0%, #006cb6 45%, #ab3a8d 100%);
        --guap-gradient-soft: linear-gradient(160deg, rgba(0, 90, 170, 0.08) 0%, rgba(171, 58, 141, 0.06) 100%);
    }

    .privacy-page {
        font-family: "Roboto", system-ui, -apple-system, sans-serif;
        max-width: 820px;
        margin: 0 auto;
        padding: 0 1rem 3rem;
    }

    .privacy-hero {
        position: relative;
        overflow: hidden;
        background: var(--guap-gradient);
        color: #fff;
        border-radius: 1.25rem;
        padding: 2.25rem 1.5rem 2.5rem;
        margin: 0.5rem 0 2rem;
        box-shadow: 0 10px 32px rgba(0, 90, 170, 0.22);
    }

    .privacy-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse 70% 80% at 0% 0%, rgba(0, 184, 238, 0.3), transparent 55%),
            radial-gradient(ellipse 60% 70% at 100% 100%, rgba(171, 58, 141, 0.35), transparent 50%);
        pointer-events: none;
    }

    .privacy-hero-inner {
        position: relative;
        z-index: 1;
    }

    .privacy-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.25);
        font-size: 0.75rem;
        font-weight: 500;
        margin-bottom: 1rem;
        backdrop-filter: blur(6px);
    }

    .privacy-hero h1 {
        font-weight: 700;
        font-size: clamp(1.5rem, 3.5vw, 2rem);
        margin: 0 0 0.65rem;
        letter-spacing: -0.02em;
        line-height: 1.2;
    }

    .privacy-hero p {
        margin: 0;
        opacity: 0.92;
        font-size: 0.95rem;
        max-width: 36rem;
        line-height: 1.55;
    }

    .privacy-intro {
        background: var(--guap-gradient-soft);
        border: 1px solid rgba(0, 90, 170, 0.12);
        border-radius: 1rem;
        padding: 1.25rem 1.35rem;
        margin-bottom: 1.75rem;
        color: #334155;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    html.dark .privacy-intro {
        background: rgba(0, 90, 170, 0.15);
        border-color: #334155;
        color: #cbd5e1;
    }

    .privacy-section {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 1.1rem;
        padding: 1.35rem 1.4rem 1.45rem;
        margin-bottom: 1rem;
        transition: box-shadow 0.15s, border-color 0.15s;
    }

    html.dark .privacy-section {
        background: #1e293b;
        border-color: #334155;
    }

    .privacy-section:hover {
        border-color: rgba(0, 90, 170, 0.3);
        box-shadow: 0 6px 20px rgba(0, 90, 170, 0.06);
    }

    .privacy-section-head {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        margin-bottom: 0.75rem;
    }

    .privacy-num {
        flex-shrink: 0;
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 0.65rem;
        background: var(--guap-gradient);
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .privacy-section h2 {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0.15rem 0 0;
        color: var(--guap-blue);
        line-height: 1.3;
    }

    html.dark .privacy-section h2 {
        color: #7eb6e8;
    }

    .privacy-section p {
        margin: 0;
        color: #475569;
        font-size: 0.92rem;
        line-height: 1.6;
    }

    html.dark .privacy-section p {
        color: #94a3b8;
    }

    .privacy-list {
        list-style: none;
        padding: 0;
        margin: 0.75rem 0 0;
        display: grid;
        gap: 0.5rem;
    }

    .privacy-list li {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        padding: 0.65rem 0.85rem;
        background: #f8fafc;
        border-radius: 0.65rem;
        font-size: 0.9rem;
        color: #334155;
        border: 1px solid #f1f5f9;
    }

    html.dark .privacy-list li {
        background: #0f172a;
        border-color: #334155;
        color: #cbd5e1;
    }

    .privacy-list li::before {
        content: "";
        flex-shrink: 0;
        width: 0.45rem;
        height: 0.45rem;
        margin-top: 0.45rem;
        border-radius: 50%;
        background: var(--guap-gradient);
    }

    .privacy-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        margin-top: 1.75rem;
        justify-content: center;
    }

    .btn-privacy {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.7rem 1.25rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: transform 0.15s, box-shadow 0.15s;
    }

    .btn-privacy-primary {
        background: var(--guap-gradient);
        color: #fff !important;
        box-shadow: 0 4px 14px rgba(0, 90, 170, 0.25);
    }

    .btn-privacy-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(0, 90, 170, 0.3);
        color: #fff !important;
    }

    .btn-privacy-outline {
        background: transparent;
        color: var(--guap-blue) !important;
        border: 1.5px solid rgba(0, 90, 170, 0.35);
    }

    html.dark .btn-privacy-outline {
        color: #7eb6e8 !important;
        border-color: #475569;
    }

    .btn-privacy-outline:hover {
        background: rgba(0, 90, 170, 0.06);
        color: var(--guap-blue-dark) !important;
    }

    .privacy-footer-note {
        text-align: center;
        font-size: 0.8rem;
        color: #94a3b8;
        margin-top: 2rem;
        line-height: 1.5;
    }

    .privacy-footer-note a {
        color: var(--guap-blue);
        text-decoration: none;
    }

    html.dark .privacy-footer-note a {
        color: #7eb6e8;
    }
</style>

<div class="privacy-page">
    <div class="privacy-hero">
        <div class="privacy-hero-inner">
            <div class="privacy-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                GUAP Messenger · защита данных
            </div>
            <h1>Политика конфиденциальности</h1>
            <p>
                Как корпоративный мессенджер ГУАП обрабатывает и защищает персональные данные
                студентов, преподавателей и сотрудников университета.
            </p>
        </div>
    </div>

    <div class="privacy-intro">
        Веб-приложение <strong>GUAP Messenger</strong> разработано для сообщества
        Государственного университета аэрокосмического приборостроения.
        Мы собираем только данные, необходимые для работы сервиса, и не передаём их третьим лицам
        без законных оснований или согласия пользователя.
    </div>

    <article class="privacy-section">
        <div class="privacy-section-head">
            <span class="privacy-num">1</span>
            <h2>Сбор информации</h2>
        </div>
        <p>
            Собираются сведения, нужные для аутентификации и обмена сообщениями:
            идентификатор и профиль из SSO ГУАП (имя, фамилия, внешний ID), содержимое чатов
            и технические данные сессии. Мы не продаём и не передаём личные данные третьим лицам
            без согласия пользователя, за исключением случаев, предусмотренных законодательством РФ.
        </p>
    </article>

    <article class="privacy-section">
        <div class="privacy-section-head">
            <span class="privacy-num">2</span>
            <h2>Использование информации</h2>
        </div>
        <p>Данные используются исключительно для:</p>
        <ul class="privacy-list">
            <li>Аутентификации через университетский SSO (OIDC) и поддержания сессии</li>
            <li>Работы личных и групповых чатов, доставки сообщений и файлов</li>
            <li>Отправки уведомлений (в том числе push) и системных событий</li>
            <li>Обеспечения безопасности, поддержки и улучшения сервиса</li>
        </ul>
    </article>

    <article class="privacy-section">
        <div class="privacy-section-head">
            <span class="privacy-num">3</span>
            <h2>Защита данных</h2>
        </div>
        <p>
            Применяются шифрование чувствительных данных (AES), защищённые каналы связи (HTTPS),
            разграничение доступа на основе политик авторизации и хранение на инфраструктуре,
            доступной авторизованным участникам университета. Доступ к данным ограничен
            и контролируется.
        </p>
    </article>

    <article class="privacy-section">
        <div class="privacy-section-head">
            <span class="privacy-num">4</span>
            <h2>Cookies и похожие технологии</h2>
        </div>
        <p>
            Приложение может использовать cookies и локальное хранилище браузера для сессии,
            темы оформления, черновиков сообщений и служебных настроек. Эти данные не используются
            для рекламы. При необходимости cookies можно ограничить в настройках браузера
            (часть функций при этом может стать недоступна).
        </p>
    </article>

    <article class="privacy-section">
        <div class="privacy-section-head">
            <span class="privacy-num">5</span>
            <h2>Ваши права</h2>
        </div>
        <p>
            Вы можете запросить уточнение, обновление или удаление данных, связанных с аккаунтом,
            а также управлять уведомлениями в настройках. Обращения по персональным данным
            направляйте администрации сервиса или через каналы поддержки ГУАП.
        </p>
    </article>

    <article class="privacy-section">
        <div class="privacy-section-head">
            <span class="privacy-num">6</span>
            <h2>Связанные сервисы ГУАП</h2>
        </div>
        <p>
            Вход выполняется через инфраструктуру университета. Обработка учётных данных SSO
            регулируется политиками ГУАП. Дополнительно см. сайты
            <a href="https://guap.ru/" target="_blank" rel="noopener">guap.ru</a>
            и
            <a href="https://pro.guap.ru/inside/profile" target="_blank" rel="noopener">pro.guap.ru</a>
            (личный кабинет).
        </p>
    </article>

    <div class="privacy-links">
        <a asp-page="/Index" class="btn-privacy btn-privacy-outline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            На главную
        </a>
        <a asp-page="/Authorization/Authorization" class="btn-privacy btn-privacy-primary">
            Войти в мессенджер
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
    </div>

    <p class="privacy-footer-note">
        GUAP Messenger · Государственный университет аэрокосмического приборостроения<br />
        Документ носит информационный характер и может обновляться при развитии сервиса.
    </p>
</div>
