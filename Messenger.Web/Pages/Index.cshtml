@page
@model IndexModel
@{
    ViewData["Title"] = "Корпоративный мессенджер ГУАП";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />

<div class="guap-landing">
    <section class="guap-hero">
        <div class="guap-hero-inner">
            <div>
                <div class="guap-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                    Государственный университет аэрокосмического приборостроения
                </div>
                <h1>GUAP Messenger</h1>
                <p class="lead">
                    Корпоративный мессенджер для студентов, преподавателей и сотрудников ГУАП.
                    Общение в реальном времени, защищённый вход через университетский SSO и привычный интерфейс.
                </p>
                <div class="guap-cta">
                    <a asp-page="/Authorization/Authorization" class="btn-guap-primary">
                        Войти в мессенджер
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                    <a href="https://pro.guap.ru/inside/profile" target="_blank" rel="noopener" class="btn-guap-ghost">
                        Личный кабинет ГУАП
                    </a>
                </div>
            </div>
            <div class="guap-hero-card">
                <h3>Почему для ГУАП</h3>
                <div class="guap-stat">
                    <span>Аутентификация</span>
                    <strong>SSO / OIDC ГУАП</strong>
                </div>
                <div class="guap-stat">
                    <span>Сообщения</span>
                    <strong>SignalR · real-time</strong>
                </div>
                <div class="guap-stat">
                    <span>Безопасность</span>
                    <strong>AES · политики доступа</strong>
                </div>
                <div class="guap-stat">
                    <span>Доступ</span>
                    <strong>Web · PWA · мобильные</strong>
                </div>
            </div>
        </div>
    </section>

    <section class="guap-section">
        <div class="guap-section-title">
            <h2>Возможности</h2>
            <p>Всё необходимое для учебной и рабочей коммуникации в одном сервисе</p>
        </div>
        <div class="guap-features">
            <div class="guap-feature">
                <div class="guap-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </div>
                <h3>Личные и групповые чаты</h3>
                <p>Приватные переписки и группы для кафедр, проектов и учебных команд.</p>
            </div>
            <div class="guap-feature">
                <div class="guap-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                </div>
                <h3>Файлы и вложения</h3>
                <p>Документы, изображения и материалы прямо в переписке — без сторонних сервисов.</p>
            </div>
            <div class="guap-feature">
                <div class="guap-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                </div>
                <h3>Мгновенная доставка</h3>
                <p>Обновления в реальном времени: сообщения, статусы «печатает» и онлайн.</p>
            </div>
            <div class="guap-feature">
                <div class="guap-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <h3>Университетский вход</h3>
                <p>Авторизация через SSO ГУАП — те же учётные данные, что и в pro.guap.ru.</p>
            </div>
            <div class="guap-feature">
                <div class="guap-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                </div>
                <h3>Уведомления</h3>
                <p>Push-уведомления на компьютере и телефоне, чтобы не пропускать важное.</p>
            </div>
            <div class="guap-feature">
                <div class="guap-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
                </div>
                <h3>Мобильный доступ</h3>
                <p>Адаптивный интерфейс и PWA — удобно с телефона, планшета и ПК.</p>
            </div>
        </div>
    </section>

    <section class="guap-section" style="padding-top: 0;">
        <div class="guap-section-title">
            <h2>Экосистема ГУАП</h2>
            <p>Сервисы университета, с которыми связан мессенджер</p>
        </div>
        <div class="guap-ecosystem">
            <div class="guap-eco-grid">
                <a class="guap-eco-link" href="https://guap.ru/" target="_blank" rel="noopener">
                    <span class="icon">У</span>
                    Сайт ГУАП
                </a>
                <a class="guap-eco-link" href="https://pro.guap.ru/inside/profile" target="_blank" rel="noopener">
                    <span class="icon">ЛК</span>
                    Личный кабинет
                </a>
                <a class="guap-eco-link" href="https://lms.guap.ru/" target="_blank" rel="noopener">
                    <span class="icon">СДО</span>
                    Дистанционное обучение
                </a>
                <a class="guap-eco-link" href="https://priem.guap.ru/" target="_blank" rel="noopener">
                    <span class="icon">ПК</span>
                    Приёмная комиссия
                </a>
            </div>
        </div>
    </section>

    <section class="guap-section" style="padding-top: 0.5rem;">
        <div class="guap-bottom-cta">
            <h2>Готовы начать общение?</h2>
            <p>Войдите с университетской учётной записью и откройте чаты</p>
            <a asp-page="/Authorization/Authorization" class="btn-guap-primary">
                Перейти к авторизации
            </a>
        </div>
        <p class="guap-footer-note">
            GUAP Messenger · для сообщества
            <a href="https://guap.ru/" target="_blank" rel="noopener">ГУАП</a>
            · <a asp-page="/Privacy">Конфиденциальность</a>
            · слоган вуза: «Учись. Изобретай. Живи.»
        </p>
    </section>
</div>
