        function getMessageTimestamp(msg) {
            return msg?.sentAt
                ?? msg?.SentAt
                ?? msg?.sentTime
                ?? msg?.SendTime
                ?? msg?.sendTime
                ?? msg?.createdAt
                ?? msg?.CreatedAt
                ?? msg?.date
                ?? msg?.timestamp
                ?? null;
        }

        function getMessageSenderId(msg) {
            return msg?.senderId ?? msg?.SenderId ?? msg?.authorId ?? msg?.userId ?? msg?.UserId ?? null;
        }

