                const chatItemAfter = document.querySelector(`.chat-item[data-chat-id="${chatId}"]`);
                if (chatItemAfter) chatItemAfter.dataset.lastMessageId = mid;

                if (isMyMessage) {
                    clearInputAfterSend();
                }

                clearUnread(msg.chatId);
