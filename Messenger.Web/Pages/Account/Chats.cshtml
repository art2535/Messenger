                    return {
                        id: pid,
                        userId: pid,
                        fullName: p.fullName || p.FullName || p.name || p.Name || `${p.firstName || p.FirstName || ''} ${p.lastName || p.LastName || ''}`.trim(),
                        name: p.name || p.Name || p.fullName,
