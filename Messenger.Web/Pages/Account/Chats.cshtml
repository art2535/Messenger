        function saveDraftForChat(chatId, text, reply = null) {
            if (!chatId) return;

            const id = String(chatId);
            const value = String(text || '');
            const drafts = getDrafts();

            if (!value.trim()) {
                delete drafts[id];
                saveDrafts();
                renderChatListDraft(id);
                refreshChatListPreviewFromDom(id);
