        <button type="button" data-emoji="😂" title="Смех">😂</button>
        <button type="button" data-emoji="😮" title="Удивление">😮</button>
        <button type="button" data-emoji="😢" title="Грусть">😢</button>
        <button type="button" data-emoji="🔥" title="Огонь">🔥</button>
        <button type="button" data-emoji="👏" title="Аплодисменты">👏</button>
        <button type="button" data-emoji="🎉" title="Праздник">🎉</button>
