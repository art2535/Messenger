@page "{chatId?}"
@model Messenger.Web.Pages.Account.ChatsModel
@{
    ViewData["Title"] = "Чаты";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />
    <title>@ViewData["Title"]</title>
    <script>
            (function () {
                const saved = localStorage.getItem('theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (saved === 'dark' || (!saved && prefersDark)) {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
            tailwind.config = {
                darkMode: 'class',
                theme: {
                    extend: {}
                }
            }
    </script>
    <script src="https://unpkg.com/feather-icons"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <partial name="_LayoutPWA" />
    <style>
            :root {
                --safe-top: env(safe-area-inset-top, 0px);
                --safe-bottom: env(safe-area-inset-bottom, 0px);
                --safe-left: env(safe-area-inset-left, 0px);
                --safe-right: env(safe-area-inset-right, 0px);
            }

            html, body {
                height: 100%;
                height: 100dvh;
                font-family: 'Roboto', system-ui, -apple-system, sans-serif;
                margin: 0;
                padding: 0;
                overflow: hidden;
                -webkit-font-smoothing: antialiased;
                -webkit-tap-highlight-color: transparent;
                overscroll-behavior: none;
            }

            .guap-gradient {
                background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            }

            #chats-sidebar {
                width: 20rem;
                flex-shrink: 0;
            }

            #mobile-back-btn {
                display: none;
            }

            #message-search-bar {
                max-width: 20rem;
            }

            @@media (max-width: 767.98px) {
                #chats-sidebar {
                    position: fixed;
                    inset: 0;
                    width: 100%;
                    max-width: 100%;
                    z-index: 40;
                    border-right: none !important;
                    padding-top: var(--safe-top);
                    padding-bottom: var(--safe-bottom);
                    padding-left: var(--safe-left);
                    padding-right: var(--safe-right);
                    transform: translateX(0);
                    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
                }

                body.mobile-chat-open #chats-sidebar {
                    transform: translateX(-100%);
                    pointer-events: none;
                }

                #right-panel {
                    position: fixed;
                    inset: 0;
                    width: 100%;
                    z-index: 30;
                    padding-top: var(--safe-top);
                    padding-bottom: var(--safe-bottom);
                    padding-left: var(--safe-left);
                    padding-right: var(--safe-right);
                    display: flex;
                    flex-direction: column;
                    background: inherit;
                }

                body:not(.mobile-chat-open) #right-panel {
                    visibility: hidden;
                    pointer-events: none;
                }

                body.mobile-chat-open #right-panel {
                    visibility: visible;
                    pointer-events: auto;
                }

                #mobile-back-btn {
                    display: flex !important;
                    align-items: center;
                    justify-content: center;
                    width: 2.75rem;
                    height: 2.75rem;
                    flex-shrink: 0;
                    margin-right: 0.25rem;
                    border-radius: 0.75rem;
                }

                #chat-header {
                    padding-top: 0.75rem;
                    padding-bottom: 0.75rem;
                    min-height: 3.5rem;
                }

                #chat-input-area {
                    padding-bottom: calc(0.75rem + var(--safe-bottom));
                }

                #messages-container {
                    -webkit-overflow-scrolling: touch;
                }

                #message-search-bar {
                    position: absolute;
                    left: 0.5rem;
                    right: 0.5rem;
                    width: auto;
                    max-width: none;
                    z-index: 10;
                }

                #search-navigation {
                    right: 1rem;
                    bottom: calc(6rem + var(--safe-bottom));
                }

                .modal > div {
                    max-height: calc(100dvh - 2rem - var(--safe-top) - var(--safe-bottom));
                    margin: 0.5rem;
                    border-radius: 1rem;
                }

                .chat-item {
                    min-height: 4.25rem;
                }

                #message-input {
                    font-size: 16px;
                    min-height: 2.75rem;
                }
            }

            @@media (min-width: 768px) and (max-width: 1023.98px) {
                #chats-sidebar {
                    width: 18rem;
                }
            }

            .chat-item:hover {
                background-color: #f3f4f6;
            }

            .dark .chat-item:hover {
                background-color: #374151 !important;
            }

            .chat-item.active {
                background-color: #e5e7eb;
            }

            .dark .chat-item.active {
                background-color: #4b5563 !important;
            }

            .dark .chat-item {
                color: #f3f4f6;
            }

                .dark .chat-item h3,
                .dark .chat-item .font-medium,
                .dark .chat-item .font-semibold {
                    color: #f3f4f6 !important;
                }

                .dark .chat-item .text-gray-500,
                .dark .chat-item .text-gray-400,
                .dark .chat-item .text-sm {
                    color: #9ca3af !important;
                }

            .dark .hover\:bg-gray-50:hover,
            .dark .hover\:bg-gray-100:hover {
                background-color: #374151 !important;
            }

            .dark .bg-gray-50 {
                background-color: #374151 !important;
            }

            .dark .bg-white {
                background-color: #1f2937 !important;
            }

            .dark .border-gray-200 {
                border-color: #374151 !important;
            }

            .dark .text-gray-800,
            .dark .text-gray-900,
            .dark .text-gray-700 {
                color: #f3f4f6 !important;
            }

            .dark .text-gray-600 {
                color: #d1d5db !important;
            }

            .dark .text-gray-500 {
                color: #9ca3af !important;
            }

            .dark .file-attachment {
                background: rgba(255,255,255,0.08);
            }

            .modal {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.5);
                backdrop-filter: blur(4px);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 50;
                opacity: 0;
                visibility: hidden;
                transition: all .3s ease;
            }

                .modal.show {
                    opacity: 1;
                    visibility: visible;
                }

            .image-preview {
                max-width: 260px;
                max-height: 260px;
                border-radius: 16px;
                cursor: zoom-in;
                object-fit: cover;
                transition: transform .2s;
            }

                .image-preview:hover {
                    transform: scale(1.05);
                }

            .file-attachment {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: rgba(0,0,0,0.06);
                padding: 10px 14px;
                border-radius: 14px;
                font-size: 13px;
            }

                .file-attachment i {
                    width: 20px;
                    height: 20px;
                }

            .lightbox {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.95);
                z-index: 100;
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 0;
                visibility: hidden;
                transition: all .3s;
            }

                .lightbox.show {
                    opacity: 1;
                    visibility: visible;
                }

                .lightbox img {
                    max-width: 90vw;
                    max-height: 90vh;
                    border-radius: 16px;
                    box-shadow: 0 20px 40px rgba(0,0,0,0.6);
                }

            .preview-attachment {
                position: relative;
                display: inline-block;
                margin: 4px;
            }

                .preview-attachment button {
                    position: absolute;
                    top: -6px;
                    right: -6px;
                    background: #ef4444;
                    color: white;
                    width: 20px;
                    height: 20px;
                    border-radius: 50%;
                    font-size: 12px;
                    border: none;
                    cursor: pointer;
                }

            .modal {
                z-index: 1000 !important;
            }

            #chat-info-search-results {
                display: none;
            }

                #chat-info-search-results.show {
                    display: block !important;
                }

            .lightbox {
                z-index: 2000 !important;
            }

            #connection-status .w-3 {
                transition: background-color 0.3s ease;
            }

            .msg-status {
                display: inline-flex;
                align-items: center;
                margin-left: 4px;
                vertical-align: middle;
            }

                .msg-status.sent {
                    color: rgba(255,255,255,0.7);
                }

                .msg-status.read {
                    color: #93c5fd;
                }

                .msg-status.pending {
                    opacity: 0.6;
                }

            .message-bubble.incoming .msg-status {
                display: none;
            }

            #user-search-results {
                position: absolute;
                z-index: 100;
                width: calc(100% - 2rem);
                left: 1rem;
                right: 1rem;
                margin-top: 0.25rem;
                background: white;
                border: 1px solid rgb(229 231 235);
                border-radius: 0.75rem;
                box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
                max-height: 16rem;
                overflow-y: auto;
                display: none;
            }

            .dark #user-search-results {
                background: #1f2937;
                border-color: #374151;
            }

            #user-search-results.show {
                display: block;
            }

            .chat-online-dot {
                box-shadow: 0 0 0 2px rgba(255,255,255,0.9);
                transition: all 0.2s ease;
            }

            .dark .chat-online-dot {
                box-shadow: 0 0 0 2px #1f2937;
            }

            .typing-in-list {
                animation: pulse 1.5s infinite;
            }

            @@keyframes pulse {
                0%, 100% {
                    opacity: 0.6;
                }

                50% {
                    opacity: 1;
                }
            }

            .typing-indicator {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                color: #3b82f6;
                font-weight: 500;
            }

            .typing-dots::after {
                content: ' ...';
                animation: typingDots 1.4s steps(4, end) infinite;
            }

            @@keyframes typingDots {
                0% {
                    content: '.';
                }

                33% {
                    content: '..';
                }

                66% {
                    content: '...';
                }
            }

            .date-separator {
                position: sticky;
                top: 8px;
                z-index: 20;
                display: flex;
                justify-content: center;
                margin: 16px 0 8px;
                padding: 0;
                background: transparent;
                pointer-events: none;
            }

                .date-separator span {
                    background: #e5e7eb;
                    color: #4b5563;
                    font-size: 12px;
                    font-weight: 500;
                    padding: 5px 14px;
                    border-radius: 9999px;
                    box-shadow: none;
                    border: none;
                    user-select: none;
                }

            .dark .date-separator span {
                background: #374151;
                color: #d1d5db;
            }

            .unread-badge {
                min-width: 20px;
                height: 20px;
                padding: 0 6px;
                background: #3b82f6;
                color: white;
                font-size: 12px;
                font-weight: 600;
                border-radius: 9999px;
                display: flex;
                align-items: center;
                justify-content: center;
                line-height: 1;
                box-shadow: 0 1px 3px rgba(59, 130, 246, 0.4);
            }

            .chat-list-message-meta { min-width: 0; }
            .chat-list-status { display: inline-flex; align-items: center; flex-shrink: 0; margin-right: 3px; vertical-align: middle; }
            .chat-list-status.sent { color: #9ca3af; }
            .chat-list-status.read { color: #3b82f6; }
            .chat-list-status.pending { color: #9ca3af; opacity: .75; }
            .chat-list-time { flex-shrink: 0; margin-left: auto; font-size: 11px; color: #9ca3af; white-space: nowrap; }
            .dark .chat-list-time { color: #9ca3af; }

            .message-bubble {
                position: relative;
                max-width: 100%;
                word-break: break-word;
            }

                .message-bubble.outgoing {
                    background: #3b82f6;
                    color: white;
                    border-radius: 16px 16px 4px 16px;
                }

                .message-bubble.incoming {
                    background: #f3f4f6;
                    color: #111827;
                    border-radius: 16px 16px 16px 4px;
                }

            .dark .message-bubble.incoming {
                background: #374151;
                color: #f3f4f6;
            }

            .message-bubble.outgoing::after {
                content: '';
                position: absolute;
                bottom: 0;
                right: -7px;
                width: 12px;
                height: 12px;
                background: #3b82f6;
                clip-path: polygon(0 0, 0 100%, 100% 100%);
            }

            .message-bubble.incoming::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: -7px;
                width: 12px;
                height: 12px;
                background: #f3f4f6;
                clip-path: polygon(100% 0, 0 100%, 100% 100%);
            }

            .dark .message-bubble.incoming::after {
                background: #374151;
            }
    </style>
</head>
<body class="h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100">
    <div class="flex h-full">
        <div id="chats-sidebar" class="w-80 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 flex flex-col">
            <div class="p-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="guap-gradient text-white w-10 h-10 rounded-full flex items-center justify-center">
                        <i data-feather="message-square" class="w-5 h-5"></i>
                    </div>
                    <h1 class="font-bold text-lg text-gray-900 dark:text-white">GUAP Messenger</h1>
                </div>
                <div class="flex items-center space-x-2">
                    <button id="theme-toggle" type="button" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 p-1.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition" title="Переключить тему">
                        <i data-feather="moon" class="w-5 h-5 theme-icon-dark hidden"></i>
                        <i data-feather="sun" class="w-5 h-5 theme-icon-light"></i>
                    </button>
                    <a asp-page="/Account/Settings" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"><i data-feather="settings" class="w-5 h-5"></i></a>
                </div>
            </div>

            <div class="p-3 border-b border-gray-200 dark:border-gray-700 space-y-2">
                <div class="relative">
                    <input type="text" id="chat-search" placeholder="Поиск по чатам"
                           class="w-full pl-10 pr-10 py-2 bg-gray-100 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white dark:focus:bg-gray-600 transition">
                    <i data-feather="search" class="absolute left-3 top-2.5 text-gray-400 w-5 h-5"></i>
                    <button id="clear-search" class="absolute right-3 top-2.5 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hidden">
                        <i data-feather="x" class="w-5 h-5"></i>
                    </button>
                </div>
                <button id="create-chat-btn" class="w-full guap-gradient text-white py-2 px-4 rounded-lg hover:opacity-90 transition flex items-center justify-center">
                    <i data-feather="plus" class="w-4 h-4 mr-2"></i> Создать чат
                </button>
            </div>

            <div class="flex-1 overflow-y-auto relative" id="chats-list">
                <div id="chats-status-container" class="flex flex-col items-center justify-center">
                    <div id="chats-loading" class="text-gray-500 dark:text-gray-400 p-4">Загрузка чатов...</div>

                    <div id="empty-state" class="hidden flex-col items-center justify-center p-8 text-center text-gray-500 dark:text-gray-400">
                        <div class="bg-gray-100 dark:bg-gray-700 p-4 rounded-full mb-4">
                            <i data-feather="message-square" class="w-8 h-8"></i>
                        </div>
                        <p class="text-lg font-medium">Чатов нет</p>
                        <p class="text-sm">Начните общение прямо сейчас</p>
                    </div>
                </div>

                <div id="chats-container"></div>
            </div>

            <div class="p-4 border-t border-gray-200 dark:border-gray-700">
                <div class="flex items-center space-x-3">
                    <div class="relative w-10 h-10">
                        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                        {
                            <img id="current-user-avatar"
                                 src="@Model.AvatarUrl?t=@DateTime.Now.Ticks"
                                 alt="Аватар"
                                 class="w-10 h-10 rounded-full object-cover shadow-md">
                        }
                        else
                        {
                            <div id="current-user-avatar-placeholder"
                                 class="guap-gradient w-10 h-10 rounded-full flex items-center justify-center shadow-md">
                                <i data-feather="user" class="w-5 h-5 text-white"></i>
                            </div>
                        }
                    </div>
                    <div>
                        <p class="font-medium text-gray-900 dark:text-white">@Model.UserName</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400">@Model.UserRole</p>
                    </div>
                    <div id="connection-status" class="relative ml-auto group">
                        <div id="status-dot" class="w-3 h-3 bg-gray-400 rounded-full"></div>
                        <div id="status-tooltip" class="absolute bottom-full right-0 mb-2 px-2 py-1 text-xs text-white bg-gray-800 rounded opacity-0 invisible group-hover:opacity-100 group-hover:visible transition">
                            Подключение...
                        </div>
                    </div>
                    <form asp-page="/Authorization/Logout" method="post" class="ml-2">
                        <button type="submit" class="text-gray-500 dark:text-gray-400 hover:text-red-600"><i data-feather="log-out" class="w-5 h-5"></i></button>
                    </form>
                </div>
            </div>
        </div>

        <div class="flex-1 flex flex-col bg-white dark:bg-gray-900" id="right-panel">
            <div id="chat-header"
                 class="hidden p-4 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 flex items-center justify-between cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-750 transition relative">

                <button type="button" id="mobile-back-btn"
                        class="text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition"
                        aria-label="Назад к списку чатов"
                        onclick="event.stopPropagation(); closeCurrentChat();">
                    <i data-feather="arrow-left" class="w-6 h-6"></i>
                </button>

                <div onclick="openChatInfo()" class="flex items-center space-x-3 flex-1 min-w-0 cursor-pointer">
                    <div class="relative">
                        <img id="chat-info-avatar"
                             src="https://novgorodskij-r49.gosweb.gosuslugi.ru/netcat_files/9/260/user_test.png"
                             class="w-11 h-11 rounded-full object-cover ring-2 ring-white dark:ring-gray-700 shadow">
                        <span id="chat-online-indicator"
                              class="absolute bottom-0 right-0 w-3.5 h-3.5 bg-green-500 rounded-full border-2 border-white dark:border-gray-800 hidden"></span>
                    </div>
                    <div class="min-w-0">
                        <h2 id="chat-title" class="font-semibold text-lg truncate text-gray-900 dark:text-white">Чат</h2>
                        <div id="chat-status-area" class="text-sm text-gray-500 dark:text-gray-400 truncate flex items-center gap-2">
                            <span id="chat-subtitle"></span>

                            <div id="typing-indicator" class="typing-indicator hidden items-center gap-1">
                                <span id="typing-name" class="font-medium text-blue-600"></span>
                                <span class="typing-dots text-blue-600">печатает</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <button id="search-toggle-btn"
                            onclick="toggleMessageSearch()"
                            class="w-9 h-9 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full transition">
                        <i data-feather="search" class="w-5 h-5"></i>
                    </button>

                    <div id="message-search-bar" class="hidden items-center bg-gray-100 dark:bg-gray-700 rounded-3xl px-4 py-1.5 w-80 transition-all">
                        <i data-feather="search" class="w-4 h-4 text-gray-400 mr-2"></i>
                        <input type="text"
                               id="message-search-input"
                               class="flex-1 bg-transparent outline-none text-sm placeholder-gray-400 dark:text-gray-100 dark:placeholder-gray-400"
                               placeholder="Поиск по сообщениям"
                               onkeypress="if(event.key === 'Enter') performMessageSearch()">

                        <button onclick="clearMessageSearch(true)"
                                class="ml-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl leading-none">
                            ✕
                        </button>
                    </div>

                    <button class="w-9 h-9 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full transition">
                        <i data-feather="phone" class="w-5 h-5"></i>
                    </button>
                    <button onclick="openChatInfo()"
                            class="w-9 h-9 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full transition">
                        <i data-feather="more-vertical" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>

            <div id="messages-container"
                 class="hidden flex-1 p-4 overflow-y-auto bg-gray-50 dark:bg-gray-900">
            </div>

            <div id="search-navigation" class="hidden fixed right-6 bottom-32 z-50 flex flex-col items-end gap-2 pointer-events-auto">
                <div id="search-counter"
                     class="hidden bg-white/95 dark:bg-gray-800/95 backdrop-blur-md shadow-md border border-gray-200 dark:border-gray-600 text-xs font-medium text-gray-600 dark:text-gray-300 px-3.5 py-1.5 rounded-2xl mb-1">
                    <span id="current-count">1</span> из <span id="total-count">5</span>
                </div>

                <button onclick="navigateSearch(-1)"
                        class="w-11 h-11 bg-white/95 dark:bg-gray-800/95 backdrop-blur-md shadow-xl hover:shadow-2xl border border-gray-200 dark:border-gray-600 rounded-2xl flex items-center justify-center text-gray-700 dark:text-gray-200 hover:text-blue-600 transition-all active:scale-95">
                    <i data-feather="chevron-up" class="w-6 h-6"></i>
                </button>

                <button onclick="navigateSearch(1)"
