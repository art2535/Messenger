            if (title) title.textContent = 'Ответ: ' + replyingTo.senderName;
            if (prev) prev.textContent = replyingTo.preview || 'Сообщение';
            if (bar) bar.classList.add('show');
            if (messageInput) messageInput.focus();
        }

