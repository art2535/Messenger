@page "{chatId?}"
@model Messenger.Web.Pages.Account.ChatsModel
@{
    ViewData["Title"] = "Чаты";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />
    <title>@ViewData["Title"]</title>
    <script>
        (function () {
            const saved = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (saved === 'dark' || (!saved && prefersDark)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {}
            }
        }
    </script>
    <script src="https://unpkg.com/feather-icons"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <partial name="_LayoutPWA" />

    <link rel="stylesheet" href="~/css/chats.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-dialogs.css" asp-append-version="true" />

</head>
<body class="h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100">
    <div class="flex h-full">
        <div id="chats-sidebar" class="w-80 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 flex flex-col">
            <div class="p-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="guap-gradient text-white w-10 h-10 rounded-full flex items-center justify-center">
                        <i data-feather="message-square" class="w-5 h-5"></i>
                    </div>
                    <h1 class="font-bold text-lg text-gray-900 dark:text-white">GUAP Messenger</h1>
                </div>
                <div class="flex items-center space-x-2">
                    <button id="theme-toggle" type="button" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 p-1.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition" title="Переключить тему">
                        <i data-feather="moon" class="w-5 h-5 theme-icon-dark hidden"></i>
                        <i data-feather="sun" class="w-5 h-5 theme-icon-light"></i>
                    </button>
                    <a asp-page="/Account/Settings" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"><i data-feather="settings" class="w-5 h-5"></i></a>
                </div>
            </div>

            <div class="p-3 border-b border-gray-200 dark:border-gray-700 space-y-2">
                <div class="relative">
                    <input type="text" id="chat-search" placeholder="Поиск по чатам"
                           class="w-full pl-10 pr-10 py-2 bg-gray-100 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white dark:focus:bg-gray-600 transition">
                    <i data-feather="search" class="absolute left-3 top-2.5 text-gray-400 w-5 h-5"></i>
                    <button id="clear-search" class="absolute right-3 top-2.5 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hidden">
                        <i data-feather="x" class="w-5 h-5"></i>
                    </button>
                </div>
                <button id="create-chat-btn" class="w-full guap-gradient text-white py-2 px-4 rounded-lg hover:opacity-90 transition flex items-center justify-center">
                    <i data-feather="plus" class="w-4 h-4 mr-2"></i> Создать чат
                </button>
            </div>

            <div class="flex-1 overflow-y-auto relative" id="chats-list">
                <div id="chats-status-container" class="flex flex-col items-center justify-center">
                    <div id="chats-loading" class="text-gray-500 dark:text-gray-400 p-4">Загрузка чатов...</div>

                    <div id="empty-state" class="hidden flex-col items-center justify-center p-8 text-center text-gray-500 dark:text-gray-400">
                        <div class="bg-gray-100 dark:bg-gray-700 p-4 rounded-full mb-4">
                            <i data-feather="message-square" class="w-8 h-8"></i>
                        </div>
                        <p class="text-lg font-medium">Чатов нет</p>
                        <p class="text-sm">Начните общение прямо сейчас</p>
                    </div>
                </div>

                <div id="chats-container"></div>
            </div>

            <div class="p-4 border-t border-gray-200 dark:border-gray-700">
                <div class="flex items-center space-x-3">
                    <div class="relative w-10 h-10">
                        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                        {
                            <img id="current-user-avatar"
                                 src="@Model.AvatarUrl?t=@DateTime.Now.Ticks"
                                 alt="Аватар"
                                 class="w-10 h-10 rounded-full object-cover shadow-md">
                        }
                        else
                        {
                            <div id="current-user-avatar-placeholder"
                                 class="guap-gradient w-10 h-10 rounded-full flex items-center justify-center shadow-md">
                                <i data-feather="user" class="w-5 h-5 text-white"></i>
                            </div>
                        }
                    </div>
                    <div>
                        <p class="font-medium text-gray-900 dark:text-white">@Model.UserName</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400">@Model.UserRole</p>
                    </div>
                    <div id="connection-status" class="relative ml-auto group">
                        <div id="status-dot" class="w-3 h-3 bg-gray-400 rounded-full"></div>
                        <div id="status-tooltip" class="absolute bottom-full right-0 mb-2 px-2 py-1 text-xs text-white bg-gray-800 rounded opacity-0 invisible group-hover:opacity-100 group-hover:visible transition">
                            Подключение...
                        </div>
                    </div>
                    <form asp-page="/Authorization/Logout" method="post" class="ml-2">
                        <button type="submit" class="text-gray-500 dark:text-gray-400 hover:text-red-600"><i data-feather="log-out" class="w-5 h-5"></i></button>
                    </form>
                </div>
            </div>
        </div>

        <div class="flex-1 flex flex-col bg-white dark:bg-gray-900" id="right-panel">
            <div id="chat-header"
                 class="hidden p-4 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 flex items-center justify-between cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-750 transition relative">

                <button type="button" id="mobile-back-btn"
                        class="text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition"
                        aria-label="Назад к списку чатов"
                        onclick="event.stopPropagation(); closeCurrentChat();">
                    <i data-feather="arrow-left" class="w-6 h-6"></i>
                </button>

                <div onclick="openChatInfo()" class="flex items-center space-x-3 flex-1 min-w-0 cursor-pointer">
                    <div class="relative">
                        <img id="chat-info-avatar"
                             src="https://novgorodskij-r49.gosweb.gosuslugi.ru/netcat_files/9/260/user_test.png"
                             class="w-11 h-11 rounded-full object-cover ring-2 ring-white dark:ring-gray-700 shadow">
                        <span id="chat-online-indicator"
                              class="absolute bottom-0 right-0 w-3.5 h-3.5 bg-green-500 rounded-full border-2 border-white dark:border-gray-800 hidden"></span>
                    </div>
                    <div class="min-w-0">
                        <h2 id="chat-title" class="font-semibold text-lg truncate text-gray-900 dark:text-white">Чат</h2>
                        <div id="chat-status-area" class="text-sm text-gray-500 dark:text-gray-400 min-w-0 w-full overflow-hidden flex items-center gap-2">
                            <span id="chat-subtitle" class="min-w-0 whitespace-nowrap"></span>

                            <div id="typing-indicator" class="typing-indicator hidden items-center gap-1">
                                <span id="typing-name" class="font-medium text-blue-600"></span>
                                <span class="typing-dots text-blue-600">печатает</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <button id="search-toggle-btn"
                            onclick="toggleMessageSearch()"
                            class="w-9 h-9 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full transition">
                        <i data-feather="search" class="w-5 h-5"></i>
                    </button>

                    <div id="message-search-bar" class="hidden items-center bg-gray-100 dark:bg-gray-700 rounded-3xl px-3 py-1.5 w-80 transition-all">
                        <i data-feather="search" class="w-4 h-4 text-gray-400 mr-2 flex-shrink-0"></i>
                        <input type="text"
                               id="message-search-input"
                               class="flex-1 min-w-0 bg-transparent outline-none text-sm placeholder-gray-400 dark:text-gray-100 dark:placeholder-gray-400"
                               placeholder="Поиск по сообщениям"
                               autocomplete="off">

                        <button type="button" id="message-search-filter-btn"
                                onclick="toggleMessageSearchFilters()"
                                title="Фильтры поиска"
                                class="ml-1 w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center text-gray-400 hover:text-gray-700 dark:hover:text-gray-100 hover:bg-gray-200/60 dark:hover:bg-gray-600 transition">
                            <i data-feather="sliders" class="w-4 h-4"></i>
                        </button>

                        <button type="button" id="message-search-close-btn"
                                onclick="clearMessageSearch(true)"
                                title="Закрыть поиск"
                                class="ml-1 w-8 h-8 rounded-full flex-shrink-0 flex items-center justify-center text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 hover:bg-gray-200/60 dark:hover:bg-gray-600 transition">
                            <i data-feather="x" class="w-4 h-4"></i>
                        </button>
                    </div>

                    <button class="w-9 h-9 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full transition">
                        <i data-feather="phone" class="w-5 h-5"></i>
                    </button>
                    <button type="button" id="export-chat-btn"
                            onclick="event.stopPropagation(); openExportChatModal(currentChatId);"
                            title="Экспорт чата"
                            class="w-9 h-9 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full transition">
                        <i data-feather="download" class="w-5 h-5"></i>
                    </button>
                    <button onclick="openChatInfo()"
                            class="w-9 h-9 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full transition">
                        <i data-feather="more-vertical" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>

            <div id="pinned-message-bar" role="button" title="К закреплённому сообщению">
                    <div class="pin-segments" id="pinned-message-segments"></div>
                    <div class="pin-body">
                        <div class="pin-title" id="pinned-message-title">Закреплённое сообщение</div>
                        <div class="pin-text" id="pinned-message-text"></div>
                    </div>
                    <button type="button" id="pinned-message-close" class="pin-close" title="Открепить">
                        <i data-feather="x" class="w-4 h-4"></i>
                    </button>
                </div>


            <div id="messages-wrapper">
                <div id="message-search-filters" class="hidden">
                    <div class="max-w-5xl mx-auto w-full">
                        <div class="flex items-center justify-between gap-3 mb-3">
                            <div class="flex items-center gap-2 min-w-0">
                                <div class="w-8 h-8 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-300 flex items-center justify-center flex-shrink-0">
                                    <i data-feather="sliders" class="w-4 h-4"></i>
                                </div>
                                <div class="min-w-0">
                                    <div class="text-sm font-semibold text-gray-900 dark:text-white">Фильтры поиска</div>
                                    <div class="text-xs text-gray-500 dark:text-gray-400 truncate">Можно искать по тексту, дате, отправителю и статусу</div>
                                </div>
                            </div>
                            <button type="button" onclick="resetMessageSearchFilters(); performMessageSearch();"
                                    class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 whitespace-nowrap">
                                Сбросить
                            </button>
                        </div>

                        <div class="grid grid-cols-1 xl:grid-cols-12 gap-2.5">
                            <div class="xl:col-span-3">
                                <label class="block text-[11px] font-medium text-gray-500 dark:text-gray-400 mb-1">Искать</label>
                                <select id="message-search-scope"
                                        class="w-full rounded-xl border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 px-3 py-2 text-sm outline-none text-gray-800 dark:text-gray-100 focus:ring-2 focus:ring-blue-500">
                                    <option value="chat">В текущем чате</option>
                                    <option value="global">Во всех чатах</option>
                                </select>
                            </div>

                            <div class="xl:col-span-2">
                                <label class="block text-[11px] font-medium text-gray-500 dark:text-gray-400 mb-1">С даты</label>
                                <input id="message-search-date-from" type="date"
                                       class="w-full rounded-xl border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 px-3 py-2 text-sm outline-none text-gray-800 dark:text-gray-100 focus:ring-2 focus:ring-blue-500">
                            </div>

                            <div class="xl:col-span-2">
                                <label class="block text-[11px] font-medium text-gray-500 dark:text-gray-400 mb-1">По дату</label>
                                <input id="message-search-date-to" type="date"
                                       class="w-full rounded-xl border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 px-3 py-2 text-sm outline-none text-gray-800 dark:text-gray-100 focus:ring-2 focus:ring-blue-500">
                            </div>

                            <div class="xl:col-span-5 relative">
                                <label class="block text-[11px] font-medium text-gray-500 dark:text-gray-400 mb-1">Отправитель</label>
                                <div class="relative">
                                    <input id="message-search-sender" type="text" autocomplete="off" placeholder="Любой отправитель"
                                           class="w-full rounded-xl border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 px-3 py-2 pr-9 text-sm outline-none text-gray-800 dark:text-gray-100 placeholder-gray-400 focus:ring-2 focus:ring-blue-500">
                                    <button type="button" id="message-search-sender-clear"
                                            class="hidden absolute right-2 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full text-gray-400 hover:text-gray-700 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-600">
                                        <i data-feather="x" class="w-3.5 h-3.5 mx-auto"></i>
                                    </button>
                                </div>
                                <input id="message-search-sender-id" type="hidden">
                                <div id="message-search-sender-results" class="hidden absolute left-0 right-0 top-full mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-xl shadow-lg z-30"></div>
                            </div>
                        </div>

                        <div class="flex flex-wrap items-center gap-2 mt-2.5">
                            <label class="inline-flex items-center gap-2 px-3 py-2 rounded-xl border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 cursor-pointer text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-600 transition">
                                <input id="message-search-has-attachments" type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                <span>С вложениями</span>
                            </label>
                            <label class="inline-flex items-center gap-2 px-3 py-2 rounded-xl border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 cursor-pointer text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-600 transition">
                                <input id="message-search-unread-only" type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                                <span>Непрочитанные</span>
                            </label>
                            <div class="flex-1 min-w-4"></div>
                            <button type="button" onclick="performMessageSearch()"
                                    class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-5 py-2.5 transition shadow-sm">
                                <i data-feather="search" class="w-4 h-4"></i>
                                Найти
                            </button>
                        </div>
                    </div>
                </div>

                <div id="messages-content-area">
                    <div id="messages-container" class="hidden p-4 overflow-y-auto bg-gray-50 dark:bg-gray-900"></div>
                    <div id="global-search-results" class="hidden bg-gray-50 dark:bg-gray-900"></div>

                    <div id="search-empty-state" class="hidden">
                        <div class="bg-white/95 dark:bg-gray-800/95 border border-gray-200 dark:border-gray-700 shadow-sm rounded-2xl px-5 py-4 text-center max-w-sm">
                            <i data-feather="search" class="w-7 h-7 mx-auto mb-2 text-gray-400 opacity-70"></i>
                            <div id="search-empty-text" class="text-sm text-gray-500 dark:text-gray-400">Ничего не найдено</div>
                        </div>
                    </div>

                    <div id="search-navigation" class="hidden flex flex-col items-end gap-2 pointer-events-auto">
                        <div id="search-counter"
                             class="hidden bg-white/95 dark:bg-gray-800/95 shadow-md border border-gray-200 dark:border-gray-600 text-xs font-medium text-gray-600 dark:text-gray-300 px-3 py-1.5 rounded-xl">
                            <span id="current-count">1</span> из <span id="total-count">5</span>
                        </div>

                        <div class="flex items-center gap-1 bg-white/95 dark:bg-gray-800/95 shadow-md border border-gray-200 dark:border-gray-600 rounded-xl p-1">
                            <button onclick="navigateSearch(-1)" title="Предыдущее"
                                    class="w-9 h-9 rounded-lg flex items-center justify-center text-gray-700 dark:text-gray-200 hover:text-blue-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-all">
                                <i data-feather="chevron-up" class="w-5 h-5"></i>
                            </button>
                            <button onclick="navigateSearch(1)" title="Следующее"
                                    class="w-9 h-9 rounded-lg flex items-center justify-center text-gray-700 dark:text-gray-200 hover:text-blue-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-all">
                                <i data-feather="chevron-down" class="w-5 h-5"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="selection-toolbar">
                <button type="button" class="sel-cancel" id="sel-cancel-btn" title="Отмена">
                    <i data-feather="x" class="w-5 h-5"></i>
                    <span>Отмена</span>
                </button>
                <span class="sel-count" id="sel-count-label">Выбрано: 0</span>
                <button type="button" class="sel-forward" id="sel-forward-btn" title="Переслать" disabled>
                    <i data-feather="corner-up-right" class="w-5 h-5"></i>
                    <span>Переслать</span>
                </button>
                <button type="button" class="sel-delete" id="sel-delete-btn" title="Удалить" disabled>
                    <i data-feather="trash-2" class="w-5 h-5"></i>
                    <span>Удалить</span>
                </button>
            </div>

            <div id="chat-input-area" class="hidden p-3 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
                <div id="input-section-container">
                    
                    <div id="reply-compose-bar">
                        <div class="reply-accent"></div>
                        <div class="reply-body">
                            <div class="reply-title" id="reply-compose-title">Ответ</div>
                            <div class="reply-preview" id="reply-compose-preview"></div>
                        </div>
                        <button type="button" class="reply-cancel" id="reply-compose-cancel" title="Отменить">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>

                    <div id="edit-mode-bar">
                        <i data-feather="edit-2" class="w-4 h-4 flex-shrink-0"></i>
                        <div class="flex flex-col min-w-0 flex-1">
                            <span class="font-medium text-xs">Редактирование</span>
                            <span class="edit-preview text-xs"></span>
                        </div>
                        <button type="button" id="cancel-edit-btn" class="p-1 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-800 text-blue-700 dark:text-blue-300" title="Отменить">
                            <i data-feather="x" class="w-4 h-4"></i>
                        </button>
                    </div>

                    <div id="normal-input-ui">
                        <div class="flex items-center space-x-2">
                            <label for="file-input" class="cursor-pointer text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200">
                                <i data-feather="paperclip" class="w-5 h-5"></i>
                            </label>
                            <input id="file-input" type="file" class="hidden" multiple>
                            <input id="message-input"
                                   type="text"
                                   placeholder="Напишите сообщение..."
                                   class="flex-1 px-4 py-2 bg-gray-100 dark:bg-gray-700 dark:text-gray-100 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white dark:focus:bg-gray-600 dark:placeholder-gray-400">
                            <button id="send-button" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200">
                                <i data-feather="send" class="w-5 h-5"></i>
                            </button>
                        </div>
                        <div id="attached-files" class="mt-2 flex flex-wrap gap-2"></div>
                    </div>
                </div>
            </div>

            <div id="empty-right-panel"
                 class="flex-1 flex flex-col items-center justify-center bg-gray-50 dark:bg-gray-900 text-gray-400 dark:text-gray-500">
                <div class="w-20 h-20 bg-white dark:bg-gray-800 rounded-3xl shadow-sm flex items-center justify-center mb-6">
                    <i data-feather="message-square" class="w-10 h-10 dark:text-gray-400"></i>
                </div>
                <p class="text-xl font-medium text-gray-600 dark:text-gray-300 mb-1">GUAP Messenger</p>
                <p class="text-sm text-center max-w-[240px] dark:text-gray-500">
                    Выберите чат из списка слева,<br>чтобы начать общение
                </p>
            </div>
        </div>
    </div>

    <div id="lightbox" class="lightbox" onclick="this.classList.remove('show'); lightboxImg.src=''">
        <img id="lightbox-img" src="" alt="">
    </div>

    <div id="create-chat-modal" class="modal">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-md p-8 relative">
            <div class="flex items-center justify-between mb-8">
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Новый чат</h3>
                <button id="close-modal" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition"><i data-feather="x" class="w-7 h-7"></i></button>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-8">
                <label class="relative cursor-pointer">
                    <input type="radio" name="chat-type" value="private" checked class="sr-only peer">
                    <div class="bg-gray-50 dark:bg-gray-700 peer-checked:bg-blue-50 dark:peer-checked:bg-blue-900/40 peer-checked:border-blue-500 border-2 border-gray-200 dark:border-gray-600 rounded-xl p-5 text-center transition-all hover:bg-gray-100 dark:hover:bg-gray-600">
                        <i data-feather="user" class="w-10 h-10 mx-auto mb-3 text-gray-600 dark:text-gray-300 peer-checked:text-blue-600"></i>
                        <span class="block text-sm font-medium text-gray-700 dark:text-gray-200">Приватный</span>
                    </div>
                </label>
                <label class="relative cursor-pointer">
                    <input type="radio" name="chat-type" value="group" class="sr-only peer">
                    <div class="bg-gray-50 dark:bg-gray-700 peer-checked:bg-blue-50 dark:peer-checked:bg-blue-900/40 peer-checked:border-blue-500 border-2 border-gray-200 dark:border-gray-600 rounded-xl p-5 text-center transition-all hover:bg-gray-100 dark:hover:bg-gray-600">
                        <i data-feather="users" class="w-10 h-10 mx-auto mb-3 text-gray-600 dark:text-gray-300 peer-checked:text-blue-600"></i>
                        <span class="block text-sm font-medium text-gray-700 dark:text-gray-200">Групповой</span>
                    </div>
                </label>
            </div>
            <div id="group-name-container" class="mb-6 hidden">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Название группы</label>
                <input type="text" id="chat-name" placeholder="Например: Друзья ГУАПа" class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Добавить участников</label>
                <div class="relative">
                    <input type="text" id="user-search" placeholder="Поиск по имени..." autocomplete="off" class="w-full px-4 py-3 pl-11 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <i data-feather="search" class="absolute left-4 top-3.5 w-5 h-5 text-gray-400"></i>
                </div>
                <div id="user-search-results"></div>
            </div>
            <div id="selected-users" class="flex flex-wrap gap-2 mb-6"></div>
            <div class="flex justify-end gap-3">
                <button id="cancel-create" class="px-6 py-3 text-gray-600 dark:text-gray-300 hover:text-gray-800 dark:hover:text-white font-medium transition">Отмена</button>
                <button id="confirm-create" class="px-8 py-3 bg-blue-600 text-white rounded-xl hover:bg-blue-700 font-medium shadow-lg transition transform hover:scale-105">Создать</button>
            </div>
        </div>
    </div>

    <div id="chat-info-modal" class="modal">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-lg p-8 max-h-screen overflow-y-auto text-gray-900 dark:text-gray-100">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-2xl font-bold dark:text-white">Информация о чате</h3>
                <button onclick="document.getElementById('chat-info-modal').classList.remove('show')" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
                    <i data-feather="x" class="w-7 h-7"></i>
                </button>
            </div>

            <div class="flex flex-col items-center mb-8">
                <img id="modal-chat-avatar" src="https://novgorodskij-r49.gosweb.gosuslugi.ru/netcat_files/9/260/user_test.png" class="w-24 h-24 rounded-full object-cover mb-4">
                <input type="text" id="modal-chat-name" class="text-2xl font-bold text-center bg-transparent border-b-2 border-transparent focus:border-blue-500 outline-none w-full dark:text-white" placeholder="Название чата">
                <p id="modal-chat-type" class="text-sm text-gray-500 dark:text-gray-400 mt-2"></p>
            </div>

            <div class="mb-6">
                <div class="flex items-center justify-between mb-3">
                    <h4 class="font-semibold dark:text-white">Участники <span id="participants-count" class="text-gray-500 dark:text-gray-400"></span></h4>
                    <button id="add-participant-btn" class="text-blue-600 dark:text-blue-400 text-sm font-medium hover:underline">+ Добавить</button>
                </div>
                <div id="participants-list" class="space-y-2"></div>
            </div>

            <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
                <h4 class="font-semibold dark:text-white mb-3 flex items-center gap-2">
                    <i data-feather="download" class="w-4 h-4"></i>
                    Экспорт истории
                </h4>
                <div class="grid grid-cols-2 gap-2">
                    <button type="button" onclick="exportChat(currentChatId, 'txt')" class="export-fmt-btn px-3 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600 text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition text-gray-800 dark:text-gray-100">TXT</button>
                    <button type="button" onclick="exportChat(currentChatId, 'json')" class="export-fmt-btn px-3 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600 text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition text-gray-800 dark:text-gray-100">JSON</button>
                    <button type="button" onclick="exportChat(currentChatId, 'html')" class="export-fmt-btn px-3 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600 text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition text-gray-800 dark:text-gray-100">HTML</button>
                    <button type="button" onclick="exportChat(currentChatId, 'csv')" class="export-fmt-btn px-3 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600 text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition text-gray-800 dark:text-gray-100">CSV</button>
                </div>
            </div>
            <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
                <button id="delete-chat-btn" class="w-full px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-xl font-medium transition transform hover:scale-105">
                    Удалить чат
                </button>
            </div>
            <div id="chat-info-footer-actions" class="flex gap-3 mt-8 w-full">
                <button type="button" id="chat-info-cancel-btn"
                        onclick="if (typeof closeChatInfoModal === 'function') closeChatInfoModal(); else document.getElementById('chat-info-modal').classList.remove('show');"
                        class="flex-1 px-6 py-3 text-gray-700 dark:text-gray-200 font-medium rounded-xl border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 transition">
                    Отмена
                </button>
                <button type="button" id="save-chat-info"
                        class="flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-medium transition hidden">
                    Сохранить изменения
                </button>
            </div>
        </div>
    </div>

    <div id="export-chat-modal" class="modal">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-sm p-6 text-gray-900 dark:text-white">
            <div class="flex items-center justify-between mb-5">
                <h3 class="text-lg font-semibold flex items-center gap-2">
                    <i data-feather="download" class="w-5 h-5"></i>
                    Экспорт чата
                </h3>
                <button type="button" onclick="closeExportChatModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
                    <i data-feather="x" class="w-6 h-6"></i>
                </button>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">Выберите формат файла:</p>
            <div class="grid grid-cols-2 gap-3">
                <button type="button" data-format="txt" class="export-modal-fmt-btn flex flex-col items-center gap-1 px-4 py-4 rounded-xl border border-gray-200 dark:border-gray-600 hover:border-blue-500 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition">
                    <span class="text-2xl font-bold text-blue-600">TXT</span>
                    <span class="text-xs text-gray-500">Текст</span>
                </button>
                <button type="button" data-format="json" class="export-modal-fmt-btn flex flex-col items-center gap-1 px-4 py-4 rounded-xl border border-gray-200 dark:border-gray-600 hover:border-blue-500 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition">
                    <span class="text-2xl font-bold text-green-600">JSON</span>
                    <span class="text-xs text-gray-500">Данные</span>
                </button>
                <button type="button" data-format="html" class="export-modal-fmt-btn flex flex-col items-center gap-1 px-4 py-4 rounded-xl border border-gray-200 dark:border-gray-600 hover:border-blue-500 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition">
                    <span class="text-2xl font-bold text-orange-600">HTML</span>
                    <span class="text-xs text-gray-500">Страница</span>
                </button>
                <button type="button" data-format="csv" class="export-modal-fmt-btn flex flex-col items-center gap-1 px-4 py-4 rounded-xl border border-gray-200 dark:border-gray-600 hover:border-blue-500 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition">
                    <span class="text-2xl font-bold text-purple-600">CSV</span>
                    <span class="text-xs text-gray-500">Таблица</span>
                </button>
            </div>
            <p id="export-status" class="text-sm text-center text-gray-500 dark:text-gray-400 mt-4 hidden"></p>
        </div>
    </div>

    <div id="ctx-menu-backdrop" class="fixed inset-0 bg-black/40 z-[2999] hidden" style="touch-action: none;"></div>

