@page "{chatId?}"
@model Messenger.Web.Pages.Account.ChatsModel
@{
    ViewData["Title"] = "Чаты";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />
    <title>@ViewData["Title"]</title>
    <script>
        (function () {
            const saved = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (saved === 'dark' || (!saved && prefersDark)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {}
            }
        }
    </script>
    <script src="https://unpkg.com/feather-icons"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <partial name="_LayoutPWA" />
    <style>
        :root {
            --safe-top: env(safe-area-inset-top, 0px);
            --safe-bottom: env(safe-area-inset-bottom, 0px);
            --safe-left: env(safe-area-inset-left, 0px);
            --safe-right: env(safe-area-inset-right, 0px);
        }

        html, body {
            height: 100%;
            height: 100dvh;
            font-family: 'Roboto', system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 0;
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
            -webkit-tap-highlight-color: transparent;
            overscroll-behavior: none;
        }

        .guap-gradient {
            background: linear-gradient(135deg, #005aaa 0%, #006cb6 45%, #ab3a8d 100%);
        }

        #chats-sidebar {
            width: 20rem;
            flex-shrink: 0;
        }

        #mobile-back-btn {
            display: none;
        }

        #message-search-bar {
            max-width: 22rem;
            min-width: 0;
        }

        #message-search-filters {
            flex: 0 0 auto;
            border-bottom: 1px solid rgb(229 231 235 / 1);
            background: rgb(255 255 255 / .98);
            padding: .75rem 1rem 1rem;
        }

        .dark #message-search-filters {
            border-bottom-color: rgb(55 65 81 / 1);
            background: rgb(31 41 55 / .98);
        }

        #message-search-sender-results {
            max-height: 11rem;
            overflow-y: auto;
        }

        #messages-wrapper {
            position: relative;
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        #messages-wrapper.hidden {
            display: none !important;
        }

        #messages-content-area {
            position: relative;
            flex: 1 1 auto;
            min-height: 0;
            overflow: hidden;
        }

        #messages-content-area #messages-container,
        #messages-content-area #global-search-results {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }

        #messages-content-area #global-search-results {
            overflow-y: auto;
        }

        #messages-content-area #search-empty-state {
            position: absolute;
            inset: 0;
            z-index: 10;
            align-items: center;
            justify-content: center;
            pointer-events: none;
            padding: 1rem;
        }

        #messages-content-area #search-empty-state:not(.hidden) {
            display: flex;
        }

        .global-search-result:hover {
            background: rgba(243, 244, 246, .8);
        }

        .dark .global-search-result:hover {
            background: rgba(55, 65, 81, .8);
        }

        #search-navigation {
            position: absolute;
            right: 1rem;
            bottom: 1rem;
            z-index: 15;
        }

        @@media (max-width: 767.98px) {
            #chats-sidebar {
                position: fixed;
                inset: 0;
                width: 100%;
                max-width: 100%;
                z-index: 40;
                border-right: none !important;
                padding-top: var(--safe-top);
                padding-bottom: var(--safe-bottom);
                padding-left: var(--safe-left);
                padding-right: var(--safe-right);
                transform: translateX(0);
                transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
            }

            body.mobile-chat-open #chats-sidebar {
                transform: translateX(-100%);
                pointer-events: none;
            }

            #right-panel {
                position: fixed;
                inset: 0;
                width: 100%;
                z-index: 30;
                padding-top: var(--safe-top);
                padding-bottom: var(--safe-bottom);
                padding-left: var(--safe-left);
                padding-right: var(--safe-right);
                display: flex;
                flex-direction: column;
                background: inherit;
            }

            body:not(.mobile-chat-open) #right-panel {
                visibility: hidden;
                pointer-events: none;
            }

            body.mobile-chat-open #right-panel {
                visibility: visible;
                pointer-events: auto;
            }

            #mobile-back-btn {
                display: flex !important;
                align-items: center;
                justify-content: center;
                width: 2.75rem;
                height: 2.75rem;
                flex-shrink: 0;
                margin-right: 0.25rem;
                border-radius: 0.75rem;
            }

            #chat-header {
                padding-top: 0.75rem;
                padding-bottom: 0.75rem;
                min-height: 3.5rem;
            }

            #chat-input-area {
                padding-bottom: calc(0.75rem + var(--safe-bottom));
            }

            #messages-container {
                -webkit-overflow-scrolling: touch;
            }

            #message-search-bar {
                position: absolute;
                left: 0.5rem;
                right: 0.5rem;
                width: auto;
                max-width: none;
                z-index: 10;
            }

            #search-navigation {
                right: 1rem;
                bottom: calc(6rem + var(--safe-bottom));
            }

            .modal > div {
                max-height: calc(100dvh - 2rem - var(--safe-top) - var(--safe-bottom));
                margin: 0.5rem;
                border-radius: 1rem;
            }

            .chat-item {
                min-height: 4.25rem;
            }

            #message-input {
                font-size: 16px;
                min-height: 2.75rem;
            }
        }

        @@media (min-width: 768px) and (max-width: 1023.98px) {
            #chats-sidebar {
                width: 18rem;
            }
        }

        .chat-item:hover {
            background-color: #f3f4f6;
        }

        .dark .chat-item:hover {
            background-color: #374151 !important;
        }

        .chat-item.active {
            background-color: #e5e7eb;
        }

        .dark .chat-item.active {
            background-color: #4b5563 !important;
        }

        .dark .chat-item {
            color: #f3f4f6;
        }

            .dark .chat-item h3,
            .dark .chat-item .font-medium,
            .dark .chat-item .font-semibold {
                color: #f3f4f6 !important;
            }

            .dark .chat-item .text-gray-500,
            .dark .chat-item .text-gray-400,
            .dark .chat-item .text-sm {
                color: #9ca3af !important;
            }

        .dark .hover\:bg-gray-50:hover,
        .dark .hover\:bg-gray-100:hover {
            background-color: #374151 !important;
        }

        .dark .bg-gray-50 {
            background-color: #374151 !important;
        }

        .dark .bg-white {
            background-color: #1f2937 !important;
        }

        .dark .border-gray-200 {
            border-color: #374151 !important;
        }

        .dark .text-gray-800,
        .dark .text-gray-900,
        .dark .text-gray-700 {
            color: #f3f4f6 !important;
        }

        .dark .text-gray-600 {
            color: #d1d5db !important;
        }

        .dark .text-gray-500 {
            color: #9ca3af !important;
        }

        .dark .file-attachment {
            background: rgba(255,255,255,0.08);
        }

        .modal {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.5);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 50;
            opacity: 0;
            visibility: hidden;
            transition: all .3s ease;
        }

            .modal.show {
                opacity: 1;
                visibility: visible;
            }

        .image-preview {
            max-width: 260px;
            max-height: 260px;
            border-radius: 16px;
            cursor: zoom-in;
            object-fit: cover;
            transition: transform .2s;
        }

            .image-preview:hover {
                transform: scale(1.05);
            }

        .file-attachment {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(0,0,0,0.06);
            padding: 10px 14px;
            border-radius: 14px;
            font-size: 13px;
        }

            .file-attachment i {
                width: 20px;
                height: 20px;
            }

        .lightbox {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.95);
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: all .3s;
        }

            .lightbox.show {
                opacity: 1;
                visibility: visible;
            }

            .lightbox img {
                max-width: 90vw;
                max-height: 90vh;
                border-radius: 16px;
                box-shadow: 0 20px 40px rgba(0,0,0,0.6);
            }

        .preview-attachment {
            position: relative;
            display: inline-block;
            margin: 4px;
        }

            .preview-attachment button {
                position: absolute;
                top: -6px;
                right: -6px;
                background: #ef4444;
                color: white;
                width: 20px;
                height: 20px;
                border-radius: 50%;
                font-size: 12px;
                border: none;
                cursor: pointer;
            }

        .modal {
            z-index: 1000 !important;
        }

        #chat-info-search-results {
            display: none;
        }

            #chat-info-search-results.show {
                display: block !important;
            }

        .lightbox {
            z-index: 2000 !important;
        }

        #connection-status .w-3 {
            transition: background-color 0.3s ease;
        }

        .msg-status {
            display: inline-flex;
            align-items: center;
            margin-left: 4px;
            vertical-align: middle;
        }

            .msg-status.sent {
                color: rgba(255,255,255,0.7);
            }

            .msg-status.read {
                color: #93c5fd;
            }

            .msg-status.pending {
                opacity: 0.6;
            }

        .message-bubble.incoming .msg-status {
            display: none;
        }

        #user-search-results {
            position: absolute;
            z-index: 100;
            width: calc(100% - 2rem);
            left: 1rem;
            right: 1rem;
            margin-top: 0.25rem;
            background: white;
            border: 1px solid rgb(229 231 235);
            border-radius: 0.75rem;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
            max-height: 16rem;
            overflow-y: auto;
            display: none;
        }

        .dark #user-search-results {
            background: #1f2937;
            border-color: #374151;
        }

        #user-search-results.show {
            display: block;
        }

        .chat-online-dot {
            box-shadow: 0 0 0 2px rgba(255,255,255,0.9);
            transition: all 0.2s ease;
        }

        .dark .chat-online-dot {
            box-shadow: 0 0 0 2px #1f2937;
        }

        .typing-in-list {
            animation: pulse 1.5s infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 0.6;
            }

            50% {
                opacity: 1;
            }
        }

        .typing-indicator {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            color: #3b82f6;
            font-weight: 500;
        }

        .typing-dots::after {
            content: ' ...';
            animation: typingDots 1.4s steps(4, end) infinite;
        }

        @@keyframes typingDots {
            0% {
                content: '.';
            }

            33% {
                content: '..';
            }

            66% {
                content: '...';
            }
        }

        .date-separator {
            position: sticky;
            top: 8px;
            z-index: 20;
            display: flex;
            justify-content: center;
            margin: 16px 0 8px;
            padding: 0;
            background: transparent;
            pointer-events: none;
        }

            .date-separator span {
                background: #e5e7eb;
                color: #4b5563;
                font-size: 12px;
                font-weight: 500;
                padding: 5px 14px;
                border-radius: 9999px;
                box-shadow: none;
                border: none;
                user-select: none;
            }

        .dark .date-separator span {
            background: #374151;
            color: #d1d5db;
        }

        .unread-badge {
            min-width: 20px;
            height: 20px;
            padding: 0 6px;
            background: #3b82f6;
            color: white;
            font-size: 12px;
            font-weight: 600;
            border-radius: 9999px;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
            box-shadow: 0 1px 3px rgba(59, 130, 246, 0.4);
        }

        .chat-list-message-meta { min-width: 0; }
        .chat-list-status { display: inline-flex; align-items: center; flex-shrink: 0; margin-right: 3px; vertical-align: middle; }
        .chat-list-status.sent { color: #9ca3af; }
        .chat-list-status.read { color: #3b82f6; }
        .chat-list-status.pending { color: #9ca3af; opacity: .75; }
        .chat-list-time { flex-shrink: 0; margin-left: auto; font-size: 11px; color: #9ca3af; white-space: nowrap; }
        .dark .chat-list-time { color: #9ca3af; }

        .message-bubble {
            position: relative;
            max-width: 100%;
            word-break: break-word;
        }

            .message-bubble.outgoing {
                background: #3b82f6;
                color: white;
                border-radius: 16px 16px 4px 16px;
            }

            .message-bubble.incoming {
                background: #d1d5db;
                color: #111827;
                border-radius: 16px 16px 16px 4px;
            }

        .dark .message-bubble.incoming {
            background: #1f2937;
            color: #f3f4f6;
        }

        .message-bubble.outgoing::after {
            content: '';
            position: absolute;
            bottom: 0;
            right: -7px;
            width: 12px;
            height: 12px;
            background: #3b82f6;
            clip-path: polygon(0 0, 0 100%, 100% 100%);
        }

        .message-bubble.incoming::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: -7px;
            width: 12px;
            height: 12px;
            background: #d1d5db;
            clip-path: polygon(100% 0, 0 100%, 100% 100%);
        }

        .dark .message-bubble.incoming::after {
            background: #1f2937;
        }

        .message-reactions {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-top: 4px;
            padding: 0 2px;
            max-width: 100%;
        }
        .message-reactions:empty {
            display: none;
        }
        .reaction-chip {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            padding: 2px 7px;
            border-radius: 12px;
            font-size: 13px;
            line-height: 1.3;
            background: rgba(0,0,0,.06);
            border: 1px solid transparent;
            cursor: pointer;
            user-select: none;
            transition: background .15s, border-color .15s;
        }
        .dark .reaction-chip {
            background: rgba(255,255,255,.08);
        }
        .reaction-chip:hover {
            background: rgba(59,130,246,.15);
        }
        .reaction-chip.mine {
            border-color: #3b82f6;
            background: rgba(59,130,246,.18);
        }
        .reaction-chip .reaction-count {
            font-size: 11px;
            font-weight: 600;
            color: #6b7280;
        }
        .dark .reaction-chip .reaction-count {
            color: #9ca3af;
        }
        .reaction-picker {
            position: fixed;
            z-index: 10050;
            display: flex;
            gap: 4px;
            padding: 8px;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(0,0,0,.15);
        }
        .dark .reaction-picker {
            background: #1f2937;
            border-color: #374151;
        }
        .reaction-picker button {
            width: 36px;
            height: 36px;
            font-size: 20px;
            border: none;
            background: transparent;
            border-radius: 10px;
            cursor: pointer;
            transition: background .15s, transform .1s;
        }
        .reaction-picker button:hover {
            background: rgba(0,0,0,.06);
            transform: scale(1.15);
        }
        .dark .reaction-picker button:hover {
            background: rgba(255,255,255,.1);
        }

        #chat-context-menu {
            position: fixed;
            z-index: 3000;
            min-width: 160px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15), 0 4px 10px rgba(0,0,0,0.08);
            border: 1px solid rgba(0,0,0,0.06);
            padding: 6px;
            display: none;
            overflow: hidden;
        }
        .dark #chat-context-menu {
            background: #1f2937;
            border-color: #374151;
        }
        #chat-context-menu.show {
            display: block;
        }
        #chat-context-menu button {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            text-align: left;
            padding: 10px 12px;
            border: none;
            background: transparent;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            color: #111827;
            transition: background 0.15s;
        }
        .dark #chat-context-menu button {
            color: #f3f4f6;
        }
        #chat-context-menu button:hover {
            background: #f3f4f6;
        }
        .dark #chat-context-menu button:hover {
            background: #374151;
        }
        #chat-context-menu button.danger {
            color: #dc2626;
        }
        .dark #chat-context-menu button.danger {
            color: #f87171;
        }
        #chat-context-menu button i {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }
        .chat-item {
            cursor: context-menu;
        }

        #message-context-menu {
            position: fixed;
            z-index: 3000;
            min-width: 160px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15), 0 4px 10px rgba(0,0,0,0.08);
            border: 1px solid rgba(0,0,0,0.06);
            padding: 6px;
            display: none;
            overflow: hidden;
        }
        .dark #message-context-menu {
            background: #1f2937;
            border-color: #374151;
        }
        #message-context-menu.show {
            display: block;
        }
        #message-context-menu button {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            text-align: left;
            padding: 10px 12px;
            border: none;
            background: transparent;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            color: #111827;
            transition: background 0.15s;
        }
        .dark #message-context-menu button {
            color: #f3f4f6;
        }
        #message-context-menu button:hover {
            background: #f3f4f6;
        }
        .dark #message-context-menu button:hover {
            background: #374151;
        }
        #message-context-menu button.danger {
            color: #dc2626;
        }
        .dark #message-context-menu button.danger {
            color: #f87171;
        }
        #message-context-menu button .ctx-icon,
        #chat-context-menu button .ctx-icon {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }
        #message-context-menu button i {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }
        .message-bubble.outgoing {
            cursor: context-menu;
        }
        #edit-mode-bar {
            display: none;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            background: #eff6ff;
            border-bottom: 1px solid #bfdbfe;
            font-size: 13px;
            color: #1e40af;
        }
        .dark #edit-mode-bar {
            background: #1e3a5f;
            border-color: #1e40af;
            color: #93c5fd;
        }
        #edit-mode-bar.show {
            display: flex;
        }
        #edit-mode-bar .edit-preview {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            opacity: 0.85;
        }
        #send-button.edit-mode {
            color: #16a34a !important;
        }
        #send-button.edit-mode:hover {
            color: #15803d !important;
        }

        #message-context-menu.show,
        #chat-context-menu.show {
            min-width: 180px;
            border-radius: 12px;
            padding: 6px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15), 0 4px 10px rgba(0,0,0,0.08);
        }
        @@media (max-width: 767.98px) {
            #message-context-menu.show,
            #chat-context-menu.show {
                left: 50% !important;
                top: 50% !important;
                right: auto !important;
                bottom: auto !important;
                transform: translate(-50%, -50%);
                width: min(280px, calc(100vw - 32px));
                min-width: 200px;
                border-radius: 16px;
                padding: 8px;
                box-shadow: 0 16px 48px rgba(0,0,0,0.22);
                animation: ctxFadeIn 0.15s ease-out;
            }
            #message-context-menu button,
            #chat-context-menu button {
                padding: 14px 16px;
                font-size: 16px;
                border-radius: 12px;
            }
            #message-context-menu button i,
            #chat-context-menu button i {
                width: 20px;
                height: 20px;
            }
        }
        @@keyframes ctxFadeIn {
            from { opacity: 0; transform: translate(-50%, -50%) scale(0.94); }
            to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        }

        #messages-container.select-mode,
        #messages-wrapper.select-mode-pad #messages-container,
        body.select-mode-active #messages-container {
            padding-bottom: 5.5rem !important;
        }
        body.select-mode-active #messages-content-area #messages-container,
        body.select-mode-active #messages-wrapper #messages-container {
            padding-bottom: 5.5rem !important;
            scroll-padding-bottom: 5.5rem;
        }

        #messages-container.select-mode .message-row.outgoing-row {
            cursor: pointer;
