    <div id="delete-message-modal" class="modal">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl">
            <div class="text-center mb-5">
                <div class="w-16 h-16 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i data-feather="trash-2" class="w-8 h-8 text-red-600 dark:text-red-400"></i>
                </div>
                <h3 id="delete-message-title" class="text-xl font-bold text-gray-900 dark:text-gray-100">Удалить сообщение?</h3>
                <p id="delete-message-hint" class="text-gray-600 dark:text-gray-400 mt-2 text-sm">Выберите, для кого удалить:</p>
            </div>
            <div class="flex flex-col gap-2.5">
                <button type="button" id="confirm-delete-for-me" class="w-full px-4 py-3 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-900 dark:text-gray-100 rounded-xl font-medium transition text-left flex items-center gap-3">
                    <span class="text-lg">👤</span>
                    <span>
                        <span class="block font-semibold">Удалить только у себя</span>
                        <span class="block text-xs text-gray-500 dark:text-gray-400 font-normal">Сообщение исчезнет только у вас</span>
                    </span>
                </button>
                <button type="button" id="confirm-delete-for-everyone" class="w-full px-4 py-3 bg-red-600 hover:bg-red-700 text-white rounded-xl font-medium transition text-left flex items-center gap-3">
                    <span class="text-lg">🌐</span>
                    <span>
                        <span class="block font-semibold">Удалить для всех</span>
                        <span class="block text-xs text-red-100 font-normal">Сообщение исчезнет у всех участников</span>
                    </span>
                </button>
                <button type="button" id="cancel-delete-message" class="w-full px-4 py-2.5 mt-1 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-xl font-medium transition">
                    Отмена
                </button>
            </div>
        </div>
    </div>


    <script>
        const sessionToken = '@(HttpContext.Session.GetString("ACCESS_TOKEN") ?? "")';
        if (sessionToken) {
            localStorage.setItem('token', sessionToken);
        }

        const isAuthenticated = @User.Identity?.IsAuthenticated.ToString().ToLower();
        const tokenSaved = @Model.TokenSaved.ToString().ToLower();

        if (!isAuthenticated && !tokenSaved) {
            console.warn("Неавторизованный доступ - редирект на авторизацию");
            window.location.href = "/Authorization/Authorization";
        }

        var token = sessionToken || localStorage.getItem('token') || '';
        var me = '@Model.UserId' || '';

        window.API_BASE_URL = '@Model.ApiBaseUrl';
        window.HUB_URL = '@Model.HubUrl';
        window.CHATS_CONFIG = {
            userId: me,
            accessToken: token,
            apiBaseUrl: window.API_BASE_URL,
            hubUrl: window.HUB_URL
        };
    </script>
