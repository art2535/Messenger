    <script src="~/js/chats/chats-pins.js" asp-append-version="true"></script>
    <script src="~/js/chats/chats-send.js" asp-append-version="true"></script>
    <script src="~/js/chats/chats-signalr.js" asp-append-version="true"></script>
    <script src="~/js/chats/chats-chat-session.js" asp-append-version="true"></script>
    <script src="~/js/chats/chats-list.js" asp-append-version="true"></script>
    <script src="~/js/chats/chats-search.js" asp-append-version="true"></script>
    <script src="~/js/chats/chats-participants.js" asp-append-version="true"></script>
    <script src="~/js/chats/chats-ui.js" asp-append-version="true"></script>
