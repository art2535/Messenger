@page
@model Messenger.Web.Pages.Account.SettingsModel
@{
    Layout = null;
    var hasAvatar = Model.HasAvatar;
    var avatarUrl = Model.AvatarUrl;
    var lastName = Model.Profile.LastName;
    var firstName = Model.Profile.FirstName;
    var fullName = $"{lastName} {firstName}";
    ViewData["Title"] = "Настройки аккаунта";
}

<!DOCTYPE html>
<html lang="ru" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)">
    <meta name="access-token" content="@Model.AccessToken">
    <title>@ViewData["Title"]</title>

    <script>
            (function () {
                const saved = localStorage.getItem('theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (saved === 'dark' || (!saved && prefersDark)) {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            })();
    </script>

    <partial name="_LayoutPWA" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
            tailwind.config = { darkMode: 'class' }
    </script>
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

    <style>
            :root {
                --safe-top: env(safe-area-inset-top, 0px);
                --safe-bottom: env(safe-area-inset-bottom, 0px);
                --safe-left: env(safe-area-inset-left, 0px);
                --safe-right: env(safe-area-inset-right, 0px);
                --sidebar-width: 280px;
            }

            html, body {
                height: 100%;
                height: 100dvh;
                margin: 0;
                font-family: 'Roboto', system-ui, -apple-system, sans-serif;
                background-color: #f8fafc;
                overflow: hidden;
                -webkit-font-smoothing: antialiased;
                -webkit-tap-highlight-color: transparent;
                overscroll-behavior: none;
            }

                html.dark, html.dark body {
                    background-color: #111827;
                }

            body {
                display: flex;
            }

            .guap-gradient {
                background: linear-gradient(135deg, #005aaa 0%, #006cb6 45%, #ab3a8d 100%);
            }

            .input-field {
                width: 100%;
                padding: 12px 16px;
                border: 1px solid #d1d5db;
                border-radius: 0.75rem;
                background-color: white;
                transition: all 0.2s;
                font-size: 16px;
            }

            .dark .input-field {
                background-color: #1f2937;
                border-color: #374151;
                color: #f3f4f6;
            }

            .input-field:focus {
                outline: none;
                border-color: #005aaa;
                box-shadow: 0 0 0 3px rgba(0, 90, 170, 0.25);
            }

            .sidebar {
                width: var(--sidebar-width);
                background: white;
                box-shadow: 2px 0 12px rgba(0,0,0,0.08);
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
                z-index: 40;
                transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .dark .sidebar {
                background: #1f2937;
                box-shadow: 2px 0 12px rgba(0,0,0,0.4);
            }

            .main-content {
                flex: 1;
                overflow-y: auto;
                overflow-x: hidden;
                padding: 1.5rem 1rem;
                padding-bottom: calc(1.5rem + var(--safe-bottom));
                background-color: #f8fafc;
                -webkit-overflow-scrolling: touch;
            }

            .dark .main-content {
                background-color: #111827;
                color: #e5e7eb;
            }

            .dark label,
            .dark .font-medium,
            .dark span.font-medium,
            .dark p.font-medium {
                color: #e5e7eb !important;
            }

            .dark .text-gray-700,
            .dark .text-gray-800,
            .dark .text-gray-900 {
                color: #f3f4f6 !important;
            }

            .dark .text-gray-500,
            .dark .text-gray-600 {
                color: #9ca3af !important;
            }

            .dark h2, .dark h3 {
                color: #f9fafb !important;
            }

            .dark .border-gray-100,
            .dark .border-gray-200 {
                border-color: #374151 !important;
            }

            .dark .bg-gray-200 {
                background-color: #374151 !important;
                color: #e5e7eb !important;
            }

            .dark .hover\:bg-gray-300:hover {
                background-color: #4b5563 !important;
            }

            .dark .modal-content {
                background: #1f2937;
                color: #e5e7eb;
            }

            .dark #confirmTitle {
                color: #f3f4f6;
            }

            .dark #confirmMessage {
                color: #9ca3af !important;
            }

            .modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.5);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 1000;
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.25s;
                padding: 1rem;
                padding-bottom: calc(1rem + var(--safe-bottom));
            }

                .modal-overlay.active {
                    opacity: 1;
                    pointer-events: all;
                }

            .modal-content {
                background: white;
                border-radius: 1rem;
                width: 100%;
                max-width: 400px;
                transform: translateY(16px);
                transition: transform 0.25s;
                box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
            }

            .modal-overlay.active .modal-content {
                transform: translateY(0);
            }

            #toast-container {
                position: fixed;
                top: calc(1rem + var(--safe-top));
                right: 1rem;
                left: 1rem;
                z-index: 9999;
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
                pointer-events: none;
            }

            @@media (min-width: 640px) {
                #toast-container {
                    left: auto;
                    max-width: 360px;
                }
            }

            .toast {
                min-width: 0;
                padding: 1rem 1.25rem;
                border-radius: 0.875rem;
                color: white;
                box-shadow: 0 10px 25px -5px rgba(0,0,0,0.2);
                transform: translateY(-20px);
                opacity: 0;
                transition: all 0.35s ease;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                pointer-events: all;
            }

                .toast.show {
                    transform: translateY(0);
                    opacity: 1;
                }

                .toast.success {
                    background: linear-gradient(135deg, #16a34a, #22c55e);
                }

                .toast.error {
                    background: linear-gradient(135deg, #dc2626, #ef4444);
                }

                .toast.info {
                    background: linear-gradient(135deg, #1e40af, #3b82f6);
                }

            #notification-types {
                transition: all 0.3s ease-in-out;
                overflow: hidden;
            }

                #notification-types.hidden {
                    opacity: 0;
                    max-height: 0;
                    padding-top: 0;
                    padding-bottom: 0;
                    margin-top: 0;
                    margin-bottom: 0;
                }

            .mobile-header {
                display: none;
                position: sticky;
                top: 0;
                z-index: 30;
                background: white;
                border-bottom: 1px solid #e5e7eb;
                padding: 0.75rem 1rem;
                padding-top: calc(0.75rem + var(--safe-top));
            }

            .dark .mobile-header {
                background: #1f2937;
                border-bottom-color: #374151;
            }

            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.45);
                z-index: 35;
                opacity: 0;
                transition: opacity 0.3s;
            }

                .sidebar-overlay.active {
                    opacity: 1;
                }

            @@media (max-width: 767.98px) {
                .mobile-header {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 0.75rem;
                }

                .sidebar {
                    position: fixed;
                    top: 0;
                    left: 0;
                    height: 100%;
                    height: 100dvh;
                    transform: translateX(-100%);
                    padding-top: var(--safe-top);
                    padding-bottom: var(--safe-bottom);
                }

                    .sidebar.open {
                        transform: translateX(0);
                    }

                .sidebar-overlay {
                    display: block;
                    pointer-events: none;
                }

                    .sidebar-overlay.active {
                        pointer-events: all;
                    }

                .main-content {
                    padding: 1rem 0.875rem;
                    padding-bottom: calc(1.25rem + var(--safe-bottom));
                }

                .form-actions {
                    flex-direction: column-reverse;
                    gap: 0.75rem !important;
                }

                    .form-actions button {
                        width: 100%;
                        justify-content: center;
                    }

                #current-avatar,
                #default-avatar,
                #avatar-preview-container {
                    width: 8.5rem !important;
                    height: 8.5rem !important;
                }

                    #default-avatar i,
                    #current-avatar i {
                        width: 3.5rem !important;
                        height: 3.5rem !important;
                    }
            }

            @@media (max-width: 400px) {
                .main-content {
                    padding-left: 0.75rem;
                    padding-right: 0.75rem;
                }
            }

            .settings-save-btn,
            button[type="submit"].bg-blue-600,
            .bg-blue-600 {
                background: linear-gradient(135deg, #005aaa, #006cb6) !important;
            }
            a.bg-blue-50, .bg-blue-50 {
                background-color: rgba(0, 90, 170, 0.08) !important;
            }
            .text-blue-600 {
                color: #005aaa !important;
            }
            .dark .text-blue-400 {
                color: #7eb6e8 !important;
            }
            .sidebar {
                border-right: 1px solid #e2e8f0;
            }
            .dark .sidebar {
                border-right-color: #334155;
            }

        #toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 99999;

            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 12px;

            pointer-events: none;
        }

        .toast {
            position: relative;

            width: 360px;
            min-height: 64px;
            box-sizing: border-box;

            display: flex;
            align-items: center;
            gap: 13px;

            padding: 14px 42px 14px 14px;

            background: rgba(25, 25, 30, 0.96);
            color: #fff;

            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;

            box-shadow:
                0 12px 40px rgba(0, 0, 0, 0.28),
                0 2px 8px rgba(0, 0, 0, 0.15);

            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);

            overflow: hidden;

            opacity: 0;
            transform: translateX(40px) scale(0.96);

            pointer-events: auto;

            transition:
                opacity 0.3s ease,
                transform 0.3s cubic-bezier(.2, .8, .2, 1);
        }

        .toast-show {
            opacity: 1;
            transform: translateX(0) scale(1);
        }

        .toast-hide {
            opacity: 0;
            transform: translateX(40px) scale(0.96);
        }

        .toast-icon {
            width: 34px;
            height: 34px;
            min-width: 34px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            font-size: 17px;
            font-weight: 700;
        }

        .toast-content {
            flex: 1;
            min-width: 0;
        }

        .toast-message {
            font-size: 14px;
            line-height: 1.45;
            font-weight: 500;

            word-break: break-word;
        }

        .toast-close {
            position: absolute;
            top: 9px;
            right: 9px;

            width: 26px;
            height: 26px;

            display: flex;
            align-items: center;
            justify-content: center;

            border: 0;
            background: transparent;
            color: rgba(255, 255, 255, 0.45);

            font-size: 20px;
            line-height: 1;

            cursor: pointer;
            border-radius: 7px;

            transition:
                color 0.2s ease,
                background 0.2s ease;
        }

        .toast-close:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.1);
        }

        .toast-success {
            border-left: 3px solid #22c55e;
        }

        .toast-success .toast-icon {
            background: rgba(34, 197, 94, 0.15);
            color: #4ade80;
        }

        .toast-error {
            border-left: 3px solid #ef4444;
        }

        .toast-error .toast-icon {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        .toast-warning {
            border-left: 3px solid #f59e0b;
        }

        .toast-warning .toast-icon {
            background: rgba(245, 158, 11, 0.15);
            color: #fbbf24;
        }

        .toast-info {
            border-left: 3px solid #3b82f6;
        }

        .toast-info .toast-icon {
            background: rgba(59, 130, 246, 0.15);
            color: #60a5fa;
        }

        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;

            height: 2px;
            width: 100%;

            opacity: 0.7;

            transform-origin: left;
            animation: toast-progress linear forwards;
        }

        .toast-success .toast-progress {
            background: #22c55e;
        }

        .toast-error .toast-progress {
            background: #ef4444;
        }

        .toast-warning .toast-progress {
            background: #f59e0b;
        }

        .toast-info .toast-progress {
            background: #3b82f6;
        }

        @@keyframes toast-progress {
            from {
                transform: scaleX(1);
            }

            to {
                transform: scaleX(0);
            }
        }

        @@media (max-width: 500px) {
            #toast-container {
                top: 12px;
                right: 12px;
                left: 12px;
            }

            .toast {
                width: 100%;
            }
        }
    </style>
</head>
<body class="flex bg-gray-50 dark:bg-gray-900">
    <div id="sidebar-overlay" class="sidebar-overlay"></div>

    <aside id="sidebar" class="sidebar">
        <div class="p-5 text-center border-b border-gray-200 dark:border-gray-700">
            <div class="guap-gradient w-11 h-11 rounded-full flex items-center justify-center mx-auto mb-2.5">
                <i data-feather="message-square" class="w-5 h-5 text-white"></i>
            </div>
            <h1 class="text-lg font-bold text-gray-800 dark:text-white">GUAP Messenger</h1>
        </div>

        <nav class="flex-1 p-3 overflow-y-auto">
            <a asp-page="/Account/Chats" asp-route-id="" asp-route-TokenSaved="true"
               class="block py-2.5 px-4 text-gray-600 dark:text-gray-300 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition active:scale-[0.98]">
                Чаты
            </a>
            <a href="#" class="block py-2.5 px-4 bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 rounded-xl font-medium">
                Настройки
            </a>

            <div class="pl-4 mt-3 space-y-0.5">
                <a href="#profile" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    Профиль
                </a>
                <a href="#notifications" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    Уведомления
                </a>
                <a href="#appearance" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    Внешний вид
                </a>
                <a href="#privacy" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    Приватность
                </a>
            </div>
        </nav>

        <div class="p-4 border-t border-gray-200 dark:border-gray-700 text-center">
            <p class="text-sm text-gray-600 dark:text-gray-400 truncate">@fullName</p>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <div class="mobile-header">
            <button id="menu-toggle" type="button"
                    class="w-11 h-11 flex items-center justify-center rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition"
                    aria-label="Открыть меню">
                <i data-feather="menu" class="w-6 h-6 text-gray-700 dark:text-gray-200"></i>
            </button>
            <h1 class="text-lg font-semibold text-gray-800 dark:text-white truncate">Настройки</h1>
            <div class="w-11"></div>
        </div>

        <main class="main-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <script>
                    window.__profileJustSaved = true;
                    window.__savedAvatarUrl = @Html.Raw(hasAvatar && !string.IsNullOrEmpty(avatarUrl)
                                            ? $"'{avatarUrl.Replace("'", "\\'")}'"
                                            : "null");
                    window.__savedDisplayName = @Html.Raw($"'{fullName.Replace("'", "\\'")}'");
                    document.addEventListener('DOMContentLoaded', () => {
                        showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]?.ToString() ?? "")), 'success');
                    });
                </script>
            }

            <div class="max-w-4xl mx-auto px-2 sm:px-0">
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-800 dark:text-white mb-6 sm:mb-8 hidden sm:block">
                    Настройки аккаунта
                </h2>
            </div>

            <form method="post" enctype="multipart/form-data" asp-page-handler="Save" class="max-w-4xl mx-auto space-y-6 sm:space-y-8">

                <section id="profile" class="bg-white dark:bg-gray-800 rounded-2xl shadow-md p-5 sm:p-8">
                    <h3 class="text-xl sm:text-2xl font-semibold text-gray-800 dark:text-white mb-6 sm:mb-8">Профиль</h3>

                    <div class="flex flex-col md:flex-row gap-8 md:gap-10 items-start">
                        <div class="flex flex-col items-center space-y-4 w-full md:w-auto">
                            <div class="relative">
                                @if (hasAvatar && !string.IsNullOrEmpty(avatarUrl))
                                {
                                    <img id="current-avatar"
                                         src="@avatarUrl?t=@DateTime.Now.Ticks"
                                         alt="Аватар"
                                         class="w-36 h-36 sm:w-40 sm:h-40 rounded-full object-cover border-4 border-gray-200 dark:border-gray-600 shadow-xl"
                                         onerror="document.getElementById('default-avatar').style.display='flex';">
                                }
                                else
                                {
                                    <div id="current-avatar" class="guap-gradient w-36 h-36 sm:w-40 sm:h-40 rounded-full flex items-center justify-center shadow-xl">
                                        <i data-feather="user" class="w-16 h-16 sm:w-20 sm:h-20 text-white"></i>
                                    </div>
                                }

                                <div id="default-avatar"
                                     class="guap-gradient w-36 h-36 sm:w-40 sm:h-40 rounded-full flex items-center justify-center shadow-xl absolute inset-0 @(hasAvatar && !string.IsNullOrEmpty(avatarUrl) ? "hidden" : "flex")">
                                    <i data-feather="user" class="w-16 h-16 sm:w-20 sm:h-20 text-white"></i>
                                </div>

                                <div id="avatar-preview-container" class="hidden absolute inset-0 rounded-full overflow-hidden border-4 border-blue-500 shadow-2xl z-20 pointer-events-none" style="background:#e5e7eb;">
                                    <img id="avatar-preview" src="" alt="Предпросмотр" class="w-full h-full object-cover" style="display:block;">
                                </div>
                            </div>

                            <div class="flex flex-col space-y-2.5 w-full max-w-xs">
                                <input type="file" id="avatarInput" name="AvatarFile" accept="image/*" class="hidden">
                                <label for="avatarInput"
                                       class="guap-gradient text-white py-3 px-6 rounded-xl hover:opacity-90 active:scale-[0.98] cursor-pointer font-medium text-center transition text-sm sm:text-base">
                                    Изменить фото
                                </label>
                                <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 text-center">
                                    JPG, PNG, GIF, WEBP · до 2 МБ
                                </p>
                                <button type="button" id="cancel-preview"
                                        class="text-sm text-gray-600 dark:text-gray-400 hover:underline hidden py-1">
                                    Отменить выбор
                                </button>
                                <button type="button" id="delete-avatar-trigger"
                                        class="text-sm text-red-600 hover:text-red-800 hover:underline py-1 @(hasAvatar ? "" : "hidden")">
                                    Удалить фото
                                </button>
                            </div>
                            <input type="hidden" name="DeleteAvatar" id="delete-avatar-flag" value="false" />
                        </div>

                        <div class="flex-1 space-y-5 w-full">
                            <div class="grid sm:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Фамилия</label>
                                    <input asp-for="Profile.LastName" class="input-field" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Имя</label>
                                    <input asp-for="Profile.FirstName" class="input-field" readonly>
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Логин (email)</label>
                                <input asp-for="Profile.Login" type="email" class="input-field" readonly>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="notifications" class="bg-white dark:bg-gray-800 rounded-2xl shadow-md p-5 sm:p-8">
                    <h3 class="text-xl sm:text-2xl font-semibold text-gray-800 dark:text-white mb-5 sm:mb-6">Уведомления</h3>
                    <div class="space-y-5">
                        <div id="ios-push-hint" class="hidden rounded-xl border border-amber-200 dark:border-amber-700/50 bg-amber-50 dark:bg-amber-900/20 p-4 text-sm text-amber-900 dark:text-amber-100">
                            <p class="font-medium mb-1.5">На iPhone / iPad push работают только из установленного приложения</p>
                            <ol class="list-decimal list-inside space-y-1 text-amber-800 dark:text-amber-200/90">
                                <li>Откройте сайт в <strong>Safari</strong></li>
                                <li>Нажмите «Поделиться» → <strong>«На экран „Домой“»</strong></li>
                                <li>Откройте GUAP Messenger с иконки на экране</li>
                                <li>Включите push в настройках</li>
                            </ol>
                            <p class="mt-2 text-xs text-amber-700 dark:text-amber-300">Нужен iOS 16.4+. В обычной вкладке Safari push недоступны.</p>
                        </div>

                        <div id="push-unsupported-hint" class="hidden rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/40 p-4 text-sm text-gray-600 dark:text-gray-300">
                            Этот браузер не поддерживает Web Push. Попробуйте Chrome / Edge на Android или Safari (как приложение) на iOS 16.4+.
                        </div>

                        <div class="flex items-center justify-between py-3 border-t border-gray-100 dark:border-gray-700">
                            <div class="pr-4">
                                <p class="font-medium text-gray-800 dark:text-gray-100">Push-уведомления</p>
                                <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5" id="push-status-text">
                                    Получать уведомления даже когда приложение закрыто
                                </p>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer flex-shrink-0">
                                <input type="checkbox" id="push-toggle" class="sr-only peer">
                                <div id="push-toggle-slider"
                                     class="w-11 h-6 bg-gray-300 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600 transition-colors">
                                </div>
                            </label>
                        </div>

                        <div id="notification-types" class="hidden">
                            <div class="space-y-4 pl-4 sm:pl-6 border-l-2 border-gray-100 dark:border-gray-700">
                                <label class="flex items-center justify-between cursor-pointer py-1">
                                    <span class="font-medium">Сообщения</span>
                                    <input type="checkbox" id="notifyMessages" class="h-5 w-5 text-blue-600 rounded">
                                </label>
                                <label class="flex items-center justify-between cursor-pointer py-1">
                                    <span class="font-medium">Групповые чаты</span>
                                    <input type="checkbox" id="notifyGroup" class="h-5 w-5 text-blue-600 rounded">
