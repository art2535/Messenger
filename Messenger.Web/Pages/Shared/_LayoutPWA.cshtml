@* PWA head — все страницы (Layout, Chats, Settings, Authorization) *@
<link rel="manifest" href="~/manifest.json" asp-append-version="true" />
<meta name="theme-color" content="#005aaa" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="GUAP Messenger" />
<meta name="application-name" content="GUAP Messenger" />
<link rel="apple-touch-icon" sizes="180x180" href="~/images/web-app-manifest-192x192.png" asp-append-version="true" />
<link rel="icon" type="image/png" sizes="192x192" href="~/images/web-app-manifest-192x192.png" asp-append-version="true" />
<link rel="icon" type="image/png" sizes="512x512" href="~/images/web-app-manifest-512x512.png" asp-append-version="true" />

<script>
    (function () {
        if (!('serviceWorker' in navigator)) return;
        window.addEventListener('load', function () {
            navigator.serviceWorker.register('/service-worker.js', { scope: '/' })
                .then(function (reg) {
                    console.log('[PWA] Service Worker зарегистрирован:', reg.scope);
                    function postConfig() {
                        var api = window.API_BASE_URL || (window.CHATS_CONFIG && window.CHATS_CONFIG.apiBaseUrl);
                        if (!api) return;
                        var target = reg.active || (navigator.serviceWorker.controller);
                        if (target) {
                            target.postMessage({ type: 'SET_CONFIG', apiBaseUrl: api });
                        } else {
                            navigator.serviceWorker.ready.then(function (r) {
                                if (r.active) r.active.postMessage({ type: 'SET_CONFIG', apiBaseUrl: api });
                            });
                        }
                    }
                    postConfig();
                    setTimeout(postConfig, 800);
                })
                .catch(function (err) {
                    console.warn('[PWA] Ошибка регистрации Service Worker:', err);
                });
        });
    })();
</script>
