@{
    var path = (Context.Request.Path.Value ?? "").TrimEnd('/').ToLowerInvariant();
    bool IsActive(string segment) => path.EndsWith(segment) || path.Contains("/settings/" + segment.Trim('/'));
    string NavClass(string segment) => IsActive(segment)
        ? "sidebar-link block py-2 px-4 text-sm bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 rounded-lg font-medium"
        : "sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg";

    var displayName = ViewData["DisplayName"] as string
        ?? ViewData["FullName"] as string
        ?? User.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value
        ?? User.Identity?.Name
        ?? "";

    var accessToken = ViewData["AccessToken"] as string ?? "";
    var apiBase = ViewData["ApiBaseUrl"] as string ?? "";
    var hubUrl = ViewData["HubUrl"] as string ?? "";
    var pageTitle = ViewData["Title"] as string ?? "Настройки";
}

<!DOCTYPE html>
<html lang="ru" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)">
    <meta name="access-token" content="@accessToken">
    <meta name="api-base" content="@apiBase">
    <title>@pageTitle — GUAP Messenger</title>

    <script>
        (function () {
            const saved = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (saved === 'dark' || (!saved && prefersDark)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    <partial name="_LayoutPWA" />

    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">
        @@custom-variant dark (&:where(.dark, .dark *));
    </style>

    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/settings-sync.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-dialogs.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="flex bg-gray-50 dark:bg-gray-900">
    <div id="sidebar-overlay" class="sidebar-overlay"></div>

    <aside id="sidebar" class="sidebar">
        <div class="p-5 text-center border-b border-gray-200 dark:border-gray-700">
            <div class="guap-gradient w-11 h-11 rounded-full flex items-center justify-center mx-auto mb-2.5">
                <i data-feather="message-square" class="w-5 h-5 text-white"></i>
            </div>
            <h1 class="text-lg font-bold text-gray-800 dark:text-white">GUAP Messenger</h1>
        </div>

        <nav class="flex-1 p-3 overflow-y-auto">
            <a asp-page="/Inside/Chats/Index"
               class="block py-2.5 px-4 text-gray-600 dark:text-gray-300 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition active:scale-[0.98]">
                Чаты
            </a>
            <a href="#" class="block py-2.5 px-4 bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 rounded-xl font-medium">
                Настройки
            </a>

            <div class="pl-4 mt-3 space-y-0.5">
                <a asp-page="/Inside/Settings/Profile/Index" class="@NavClass("profile")">Профиль</a>
                <a asp-page="/Inside/Settings/Security/Index" class="@NavClass("security")">Безопасность</a>
                <a asp-page="/Inside/Settings/Notifications/Index" class="@NavClass("notifications")">Уведомления</a>
                <a asp-page="/Inside/Settings/Appearance/Index" class="@NavClass("appearance")">Внешний вид</a>
                <a asp-page="/Inside/Settings/Folders/Index" class="@NavClass("folders")">Папки чатов</a>
                <a asp-page="/Inside/Settings/Privacy/Index" class="@NavClass("privacy")">Конфиденциальность</a>
                <a id="nav-admin-link" asp-page="/Inside/Settings/Admin/Index"
                   class="@(IsActive("admin") ? NavClass("admin") : "sidebar-link hidden block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg")">Админ-панель</a>
            </div>
        </nav>

        <div class="p-4 border-t border-gray-200 dark:border-gray-700 space-y-3">
            <p class="text-sm text-gray-600 dark:text-gray-400 truncate text-center">@displayName</p>
            <form asp-page="/Logout" method="post" data-logout="true" class="w-full">
                <button type="submit"
                        class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition active:scale-[0.98] font-medium text-sm"
                        title="Выйти из аккаунта">
                    <i data-feather="log-out" class="w-4 h-4"></i>
                    <span>Выйти</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <div class="mobile-header">
            <button id="menu-toggle" type="button"
                    class="w-11 h-11 flex items-center justify-center rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition"
                    aria-label="Открыть меню">
                <i data-feather="menu" class="w-6 h-6 text-gray-700 dark:text-gray-200"></i>
            </button>
            <h1 class="text-lg font-semibold text-gray-800 dark:text-white truncate">@pageTitle</h1>
            <div class="w-11"></div>
        </div>

        <main class="main-content p-4 sm:p-6">
            @RenderBody()
        </main>
    </div>

    <div id="toast-container"></div>

    <div id="confirmModal" class="modal-overlay">
        <div class="modal-content p-6 sm:p-8 text-center">
            <h3 class="text-lg sm:text-xl font-semibold mb-3" id="confirmTitle">Подтвердите действие</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-6 sm:mb-8 text-sm sm:text-base" id="confirmMessage"></p>
            <div class="flex flex-col-reverse sm:flex-row justify-center gap-3">
                <button onclick="closeConfirm(false)"
                        class="px-6 py-3 bg-gray-200 dark:bg-gray-600 rounded-xl hover:bg-gray-300 dark:hover:bg-gray-500 font-medium">
                    Отмена
                </button>
                <button id="confirmYesBtn"
                        class="px-6 py-3 guap-gradient text-white rounded-xl hover:opacity-90 font-medium">
                    Подтвердить
                </button>
            </div>
        </div>
    </div>

    <script>
        const sessionToken = '@(Context.Session.GetString("ACCESS_TOKEN") ?? "")';
        const modelToken = '@accessToken';
        (function persistToken() {
            const t = (modelToken || sessionToken || localStorage.getItem('token') || '').trim();
            if (t) {
                try { localStorage.setItem('token', t.replace(/^Bearer\s+/i, '')); } catch (_) {}
            }
        })();
        const isAuthenticated = @((User.Identity?.IsAuthenticated == true).ToString().ToLower());
        const hasClientToken = !!(localStorage.getItem('token') || sessionToken || modelToken);
        if (!isAuthenticated && !hasClientToken) {
            console.warn("Settings: Неавторизованный доступ - редирект");
            window.location.href = "/login";
        }
        function getAuthToken() {
            const raw = (modelToken || localStorage.getItem('token') || sessionToken || '').trim();
            if (!raw) return '';
            return raw.startsWith('Bearer ') ? raw : raw;
        }
        window.API_BASE_URL = '@apiBase';
        window.HUB_URL = '@hubUrl';
    </script>
    <script src="~/js/utils/toast.js" asp-append-version="true"></script>
    <script src="~/js/utils/ui-dialogs.js" asp-append-version="true"></script>
    <script src="~/app.js"></script>
    <script src="~/js/utils/session-cleanup.js"></script>
    <script src="~/js/settings/settings.js" asp-append-version="true"></script>
    <script src="~/js/settings/settings-admin-nav.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof feather !== 'undefined') feather.replace();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
