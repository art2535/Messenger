@page "/inside/settings/security"
@model Messenger.Web.Pages.Inside.Settings.Security.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Безопасность";
}

<!DOCTYPE html>
<html lang="ru" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)">
    <title>@ViewData["Title"]</title>
    <script>
        (function () {
            const saved = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (saved === 'dark' || (!saved && prefersDark)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
    <partial name="_LayoutPWA" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>
    <script src="https://unpkg.com/feather-icons"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-dialogs.css" asp-append-version="true" />
</head>
<body class="flex bg-gray-50 dark:bg-gray-900">
    <div id="sidebar-overlay" class="sidebar-overlay"></div>

    <aside id="sidebar" class="sidebar">
        <div class="p-5 text-center border-b border-gray-200 dark:border-gray-700">
            <div class="guap-gradient w-11 h-11 rounded-full flex items-center justify-center mx-auto mb-2.5">
                <i data-feather="message-square" class="w-5 h-5 text-white"></i>
            </div>
            <h1 class="text-lg font-bold text-gray-800 dark:text-white">GUAP Messenger</h1>
        </div>

        <nav class="flex-1 p-3 overflow-y-auto">
            <a asp-page="/Inside/Chats/Index" class="block py-2.5 px-4 text-gray-600 dark:text-gray-300 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition active:scale-[0.98]">
                Чаты
            </a>
            <a href="#" class="block py-2.5 px-4 bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 rounded-xl font-medium">
                Настройки
            </a>
            <div class="pl-4 mt-3 space-y-0.5">
                <a asp-page="/Inside/Settings/Profile/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Профиль</a>
                <a asp-page="/Inside/Settings/Security/Index" class="sidebar-link block py-2 px-4 text-sm bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 rounded-lg font-medium">Безопасность</a>
                <a asp-page="/Inside/Settings/Notifications/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Уведомления</a>
                <a asp-page="/Inside/Settings/Appearance/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Внешний вид</a>
                <a asp-page="/Inside/Settings/Privacy/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Конфиденциальность</a>
            </div>
        </nav>

        <div class="p-4 border-t border-gray-200 dark:border-gray-700">
            <form asp-page="/Logout" method="post" data-logout="true" class="w-full">
                <button type="submit" class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition font-medium text-sm active:scale-[0.98]">
                    <i data-feather="log-out" class="w-4 h-4"></i>
                    <span>Выйти</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <div class="mobile-header">
            <button id="menu-toggle" type="button" class="w-11 h-11 flex items-center justify-center rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition" aria-label="Открыть меню">
                <i data-feather="menu" class="w-6 h-6 text-gray-700 dark:text-gray-200"></i>
            </button>
            <h1 class="text-lg font-semibold text-gray-800 dark:text-white truncate">Безопасность</h1>
            <div class="w-11"></div>
        </div>

        <main class="main-content p-4 sm:p-6">
            <div class="max-w-4xl mx-auto space-y-5 sm:space-y-6">
                <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 dark:text-white hidden sm:block">Безопасность</h2>

                <section class="settings-card">
                    <div class="settings-card-header">
                        <div class="settings-icon-wrap bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400">
                            <i data-feather="shield" class="w-5 h-5"></i>
                        </div>
                        <div class="min-w-0">
                            <h3 class="settings-card-title">Вход через SSO ГУАП</h3>
                            <p class="settings-card-desc">Аутентификация через корпоративный Keycloak</p>
                        </div>
                    </div>
                    <div class="rounded-xl bg-gray-50 dark:bg-gray-900/50 border border-gray-100 dark:border-gray-700 p-4 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                        Пароль и двухфакторная аутентификация управляются в&nbsp;личном кабинете ГУАП / SSO.
                        В мессенджере хранится только сессия и токены доступа.
                    </div>
                    <a href="https://sso.guap.ru" target="_blank" rel="noopener"
                       class="mt-4 inline-flex items-center justify-center gap-2 w-full sm:w-auto px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-600 text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition active:scale-[0.98]">
                        <i data-feather="external-link" class="w-4 h-4"></i>
                        Открыть настройки SSO
                    </a>
                </section>

                <section class="settings-card">
                    <div class="settings-card-header">
                        <div class="settings-icon-wrap bg-amber-50 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400">
                            <i data-feather="smartphone" class="w-5 h-5"></i>
                        </div>
                        <div class="min-w-0">
                            <h3 class="settings-card-title">Сессии</h3>
                            <p class="settings-card-desc">Управление активными входами</p>
                        </div>
                    </div>

                    <div class="settings-row">
                        <div class="settings-row-text">
                            <span class="settings-row-label">Текущее устройство</span>
                            <span class="settings-row-hint" id="session-device-hint">Этот браузер · активная сессия</span>
                        </div>
                        <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400 px-2 py-1 rounded-lg bg-emerald-50 dark:bg-emerald-900/30">Сейчас</span>
                    </div>

                    <div class="settings-row border-0">
                        <div class="settings-row-text">
                            <span class="settings-row-label">Автовыход при бездействии</span>
                            <span class="settings-row-hint">Сессия закрывается после долгого простоя</span>
                        </div>
                        <label class="toggle">
                            <input type="checkbox" class="toggle-input pref-toggle" data-pref="security.idleLogout" checked>
                            <span class="toggle-track"></span>
                        </label>
                    </div>

                    <form asp-page="/Logout" method="post" data-logout="true" class="mt-2">
                        <button type="submit"
                                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 text-sm font-medium hover:bg-red-100 dark:hover:bg-red-900/40 transition active:scale-[0.98]">
                            <i data-feather="log-out" class="w-4 h-4"></i>
                            Выйти на этом устройстве
                        </button>
                    </form>
                </section>

                <section class="settings-card">
                    <div class="settings-card-header">
                        <div class="settings-icon-wrap bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400">
                            <i data-feather="lock" class="w-5 h-5"></i>
                        </div>
                        <div class="min-w-0">
                            <h3 class="settings-card-title">Шифрование</h3>
                            <p class="settings-card-desc">Защита данных в покое</p>
                        </div>
                    </div>
                    <ul class="space-y-3 text-sm text-gray-600 dark:text-gray-300">
                        <li class="flex gap-3 items-start">
                            <i data-feather="check-circle" class="w-4 h-4 text-emerald-500 mt-0.5 flex-shrink-0"></i>
                            <span>Тела сообщений шифруются на сервере (AES-GCM)</span>
                        </li>
                        <li class="flex gap-3 items-start">
                            <i data-feather="check-circle" class="w-4 h-4 text-emerald-500 mt-0.5 flex-shrink-0"></i>
                            <span>Соединение с приложением — HTTPS / TLS</span>
                        </li>
                        <li class="flex gap-3 items-start">
                            <i data-feather="check-circle" class="w-4 h-4 text-emerald-500 mt-0.5 flex-shrink-0"></i>
                            <span>Токены обновляются в фоне и отзываются при выходе</span>
                        </li>
                    </ul>
                </section>

                <section class="settings-card border-red-100 dark:border-red-900/40">
                    <div class="settings-card-header">
                        <div class="settings-icon-wrap bg-red-50 dark:bg-red-900/30 text-red-600 dark:text-red-400">
                            <i data-feather="alert-triangle" class="w-5 h-5"></i>
                        </div>
                        <div class="min-w-0">
                            <h3 class="settings-card-title">Опасная зона</h3>
                            <p class="settings-card-desc">Действия, которые нельзя отменить локально</p>
                        </div>
                    </div>
                    <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                        Удаление аккаунта и полная очистка данных выполняются через администрацию ГУАП или службу поддержки мессенджера.
                    </p>
                    <button type="button" id="btn-clear-local"
                            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-600 text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition active:scale-[0.98]">
                        <i data-feather="trash-2" class="w-4 h-4"></i>
                        Очистить локальный кэш (offline)
                    </button>
                </section>
            </div>
        </main>
    </div>

    <div id="toast-container"></div>

    <script src="~/js/ui-dialogs.js" asp-append-version="true"></script>
    <script src="~/js/settings.js" asp-append-version="true"></script>
    <script src="~/js/settings-prefs.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof feather !== 'undefined') feather.replace();
            if (typeof initPrefToggles === 'function') initPrefToggles();

            const hint = document.getElementById('session-device-hint');
            if (hint) {
                const ua = navigator.userAgent || '';
                let device = 'Браузер';
                if (/iPhone|iPad/i.test(ua)) device = 'iOS';
                else if (/Android/i.test(ua)) device = 'Android';
                else if (/Windows/i.test(ua)) device = 'Windows';
                else if (/Mac/i.test(ua)) device = 'macOS';
                hint.textContent = device + ' · этот браузер · активная сессия';
            }

            document.getElementById('btn-clear-local')?.addEventListener('click', async () => {
                try {
                    if (window.indexedDB && indexedDB.databases) {
                        const dbs = await indexedDB.databases();
                        for (const db of dbs) {
                            if (db.name) indexedDB.deleteDatabase(db.name);
                        }
                    }
                    const keys = [];
                    for (let i = 0; i < localStorage.length; i++) {
                        const k = localStorage.key(i);
                        if (k && (k.startsWith('notif.') || k.startsWith('privacy.') || k.startsWith('security.') || k === 'pushSubscribed'))
                            keys.push(k);
                    }
                    keys.forEach(k => localStorage.removeItem(k));
                    if (typeof showToast === 'function') showToast('Локальный кэш очищен', 'success');
                    else alert('Локальный кэш очищен');
                } catch (e) {
                    if (typeof showToast === 'function') showToast('Не удалось очистить кэш', 'error');
                }
            });
        });
    </script>
</body>
</html>
