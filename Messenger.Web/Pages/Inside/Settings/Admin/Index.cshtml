@page "/inside/settings/admin"
@model Messenger.Web.Pages.Inside.Settings.Admin.IndexModel
@{
    Layout = null;
    var fullName = Model.DisplayName;
    ViewData["Title"] = "Админ-панель";
}

<!DOCTYPE html>
<html lang="ru" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="access-token" content="@Model.AccessToken">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)">
    <title>@ViewData["Title"]</title>
    <script>
        (function () {
            const saved = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (saved === 'dark' || (!saved && prefersDark)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
    <partial name="_LayoutPWA" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>
    <script src="https://unpkg.com/feather-icons"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/settings-sync.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-dialogs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chats-features.css" asp-append-version="true" />
    <style>
        .admin-stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
        .admin-stat-card { background: rgba(59,130,246,.08); border: 1px solid rgba(148,163,184,.25); border-radius: 12px; padding: 14px; }
        .admin-stat-card .value { font-size: 22px; font-weight: 700; }
        .admin-stat-card .label { font-size: 12px; opacity: .7; }
        .admin-btn { font-size: 12px; padding: 4px 10px; border-radius: 8px; font-weight: 500; border: none; cursor: pointer; }
        .admin-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .admin-table th, .admin-table td { padding: 8px; border-bottom: 1px solid rgba(148,163,184,.25); text-align: left; }
        .dark .admin-stat-card { background: rgba(30,41,59,.8); }
    </style>
</head>
<body class="flex bg-gray-50 dark:bg-gray-900">
    <div id="sidebar-overlay" class="sidebar-overlay"></div>

    <aside id="sidebar" class="sidebar">
        <div class="p-5 text-center border-b border-gray-200 dark:border-gray-700">
            <div class="guap-gradient w-11 h-11 rounded-full flex items-center justify-center mx-auto mb-2.5">
                <i data-feather="message-square" class="w-5 h-5 text-white"></i>
            </div>
            <h1 class="text-lg font-bold text-gray-800 dark:text-white">GUAP Messenger</h1>
        </div>
        <nav class="flex-1 p-3 overflow-y-auto">
            <a asp-page="/Inside/Chats/Index" class="block py-2.5 px-4 text-gray-600 dark:text-gray-300 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition">Чаты</a>
            <a href="#" class="block py-2.5 px-4 bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 rounded-xl font-medium">Настройки</a>
            <div class="pl-4 mt-3 space-y-0.5">
                <a asp-page="/Inside/Settings/Profile/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Профиль</a>
                <a asp-page="/Inside/Settings/Security/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Безопасность</a>
                <a asp-page="/Inside/Settings/Notifications/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Уведомления</a>
                <a asp-page="/Inside/Settings/Appearance/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Внешний вид</a>
                <a asp-page="/Inside/Settings/Folders/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Папки чатов</a>
                <a asp-page="/Inside/Settings/Privacy/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Конфиденциальность</a>
                <a asp-page="/Inside/Settings/Admin/Index" id="nav-admin-link" class="sidebar-link block py-2 px-4 text-sm bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 rounded-lg font-medium">Админ-панель</a>
            </div>
        </nav>
        <div class="p-4 border-t border-gray-200 dark:border-gray-700">
            <p class="text-sm text-gray-600 dark:text-gray-400 truncate text-center">@fullName</p>
            <form asp-page="/Logout" method="post" data-logout="true" class="w-full">
                <button type="submit" class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition font-medium text-sm">
                    <i data-feather="log-out" class="w-4 h-4"></i> Выйти
                </button>
            </form>
        </div>
    </aside>

    <main class="flex-1 overflow-y-auto p-4 sm:p-8">
        <button type="button" id="sidebar-toggle" class="mb-4 lg:hidden p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800">
            <i data-feather="menu" class="w-5 h-5"></i>
        </button>

        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Админ-панель системы</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Только для роли «Администратор». Статистика, жалобы, mute, логи.</p>

        <div id="admin-loading" class="text-sm text-gray-500">Загрузка…</div>
        <div id="admin-forbidden" class="hidden p-4 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300">
            Недостаточно прав. Нужна роль «Администратор» в базе (User_Roles).
        </div>

        <div id="admin-content" class="hidden space-y-8">
            <section>
                <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-3">Активность</h2>
                <div class="admin-stats-grid" id="admin-stats"></div>
            </section>

            <section>
                <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-3">Жалобы</h2>
                <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-700">
                    <table class="admin-table" id="admin-reports">
                        <thead>
                            <tr>
                                <th>Дата</th>
                                <th>Причина</th>
                                <th>Сообщение</th>
                                <th>Статус</th>
                                <th style="min-width:200px">Действия</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </section>

            <section>
                <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-3">Активные mute</h2>
                <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-700">
                    <table class="admin-table" id="admin-mutes">
                        <thead>
                            <tr>
                                <th>User ID</th>
                                <th>До</th>
                                <th>Причина</th>
                                <th style="min-width:120px">Действия</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </section>

            <section>
                <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-3">Логи модерации</h2>
                <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-700">
                    <table class="admin-table" id="admin-logs">
                        <thead>
                            <tr>
                                <th>Дата</th>
                                <th>Действие</th>
                                <th>Детали</th>
                                <th style="min-width:100px">Действия</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>

    <script>
        feather.replace();
        document.getElementById('sidebar-toggle')?.addEventListener('click', () => {
            document.getElementById('sidebar')?.classList.toggle('open');
            document.getElementById('sidebar-overlay')?.classList.toggle('show');
        });
        document.getElementById('sidebar-overlay')?.addEventListener('click', () => {
            document.getElementById('sidebar')?.classList.remove('open');
            document.getElementById('sidebar-overlay')?.classList.remove('show');
        });

        (async function () {
            window.API_BASE_URL = '@Model.ApiBaseUrl';
            const API = window.API_BASE_URL.replace(/\/$/, '');
            const tokenMeta = document.querySelector('meta[name="access-token"]')?.content || '';
            function authHeaders() {
                let t = tokenMeta || localStorage.getItem('token') || '';
                t = t.replace(/^Bearer\s+/i, '');
                return t ? { 'Authorization': 'Bearer ' + t, 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json' };
            }
            async function api(path, opts = {}) {
                const res = await fetch(API + path, { ...opts, headers: { ...authHeaders(), ...(opts.headers || {}) }, credentials: 'include' });
                return res;
            }
            function esc(s) {
                return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
            }
            function btn(cls, label, attrs) {
                return `<button type="button" class="admin-btn ${cls}" ${attrs}>${label}</button>`;
            }

            const statsRes = await api('/admin/stats');
            document.getElementById('admin-loading')?.classList.add('hidden');
            if (statsRes.status === 401) { location.href = '/login'; return; }
            if (statsRes.status === 403 || !statsRes.ok) {
                document.getElementById('admin-forbidden')?.classList.remove('hidden');
                return;
            }
            document.getElementById('admin-content')?.classList.remove('hidden');
            const statsJson = await statsRes.json();
            const s = statsJson.data || statsJson.Data || statsJson;
            const cards = [
                ['Пользователи', s.totalUsers ?? s.TotalUsers ?? 0],
                ['Онлайн', s.onlineUsers ?? s.OnlineUsers ?? 0],
                ['Сообщения 24ч', s.messagesLast24h ?? s.MessagesLast24h ?? 0],
                ['Сообщения 7д', s.messagesLast7d ?? s.MessagesLast7d ?? 0],
                ['Чаты 24ч', s.activeChatsLast24h ?? s.ActiveChatsLast24h ?? 0],
                ['Жалобы', s.pendingReports ?? s.PendingReports ?? 0],
                ['Mute', s.activeMutes ?? s.ActiveMutes ?? 0]
            ];
            document.getElementById('admin-stats').innerHTML = cards.map(([label, value]) =>
                `<div class="admin-stat-card"><div class="value text-gray-900 dark:text-white">${value}</div><div class="label text-gray-600 dark:text-gray-400">${label}</div></div>`
            ).join('');

            async function loadReports() {
                const res = await api('/admin/reports');
                const json = await res.json().catch(() => ({}));
                const list = json.data || json.Data || [];
                const tb = document.querySelector('#admin-reports tbody');
                if (!list.length) {
                    tb.innerHTML = '<tr><td colspan="5" class="text-gray-500">Нет жалоб</td></tr>';
                    return;
                }
                tb.innerHTML = list.map(r => {
                    const id = r.reportId || r.ReportId;
                    const date = r.createdAt || r.CreatedAt;
                    const reason = esc(r.reason || r.Reason || '');
                    const preview = esc(r.messagePreview || r.MessagePreview || r.comment || r.Comment || '');
                    const status = esc(r.status || r.Status || 'pending');
                    return `<tr data-id="${id}">
                        <td class="text-gray-700 dark:text-gray-300">${date ? new Date(date).toLocaleString() : ''}</td>
                        <td class="text-gray-700 dark:text-gray-300">${reason}</td>
                        <td class="text-gray-500 max-w-xs truncate" title="${preview}">${preview}</td>
                        <td><span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-200">${status}</span></td>
                        <td class="space-x-1 whitespace-nowrap">
                            ${btn('ok', 'Принять', `data-act="action_taken" data-id="${id}"`)}
                            ${btn('warn', 'Отклонить', `data-act="dismissed" data-id="${id}"`)}
                            ${btn('danger', 'Удалить', `data-act="delete" data-id="${id}"`)}
                        </td>
                    </tr>`;
                }).join('');
                tb.querySelectorAll('button[data-act]').forEach(btnEl => {
                    btnEl.onclick = async () => {
                        const id = btnEl.dataset.id;
                        const act = btnEl.dataset.act;
                        btnEl.disabled = true;
                        if (act === 'delete') {
                            await api('/admin/reports/' + id, { method: 'DELETE' });
                        } else {
                            await api('/admin/reports/' + id + '/review', {
                                method: 'POST',
                                body: JSON.stringify({ status: act })
                            });
                        }
                        loadReports();
                    };
                });
            }

            async function loadMutes() {
                const res = await api('/admin/mutes');
                const json = await res.json().catch(() => ({}));
                const list = json.data || json.Data || [];
                const tb = document.querySelector('#admin-mutes tbody');
                if (!list.length) {
                    tb.innerHTML = '<tr><td colspan="4" class="text-gray-500">Нет активных mute</td></tr>';
                    return;
                }
                tb.innerHTML = list.map(m => {
                    const id = m.muteId || m.MuteId;
                    const uid = esc(m.userId || m.UserId || '');
                    const until = m.mutedUntil || m.MutedUntil;
                    const reason = esc(m.reason || m.Reason || '');
                    return `<tr>
                        <td class="text-gray-700 dark:text-gray-300 font-mono text-xs">${uid}</td>
                        <td class="text-gray-700 dark:text-gray-300">${until ? new Date(until).toLocaleString() : ''}</td>
                        <td class="text-gray-500">${reason}</td>
                        <td>${btn('ok', 'Снять', `data-unmute="${id}"`)}</td>
                    </tr>`;
                }).join('');
                tb.querySelectorAll('[data-unmute]').forEach(btnEl => {
                    btnEl.onclick = async () => {
                        btnEl.disabled = true;
                        await api('/moderation/unmute/' + btnEl.dataset.unmute, { method: 'POST' });
                        loadMutes();
                    };
                });
            }

            async function loadLogs() {
                const res = await api('/admin/logs?take=50');
                const json = await res.json().catch(() => ({}));
                const list = json.data || json.Data || [];
                const tb = document.querySelector('#admin-logs tbody');
                if (!list.length) {
                    tb.innerHTML = '<tr><td colspan="4" class="text-gray-500">Пусто</td></tr>';
                    return;
                }
                tb.innerHTML = list.map(l => {
                    const id = l.logId || l.LogId || '';
                    const date = l.createdAt || l.CreatedAt;
                    const action = esc(l.action || l.Action || '');
                    const details = esc(l.details || l.Details || '');
                    return `<tr data-log="${id}">
                        <td class="text-gray-700 dark:text-gray-300">${date ? new Date(date).toLocaleString() : ''}</td>
                        <td class="text-gray-700 dark:text-gray-300">${action}</td>
                        <td class="text-gray-500 max-w-md truncate" title="${details}">${details}</td>
                        <td>${id ? btn('danger', 'Удалить', `data-del-log="${id}"`) : ''}</td>
                    </tr>`;
                }).join('');
                tb.querySelectorAll('[data-del-log]').forEach(btnEl => {
                    btnEl.onclick = async () => {
                        if (!confirm('Удалить запись лога?')) return;
                        btnEl.disabled = true;
                        const r = await api('/admin/logs/' + btnEl.dataset.delLog, { method: 'DELETE' });
                        if (r.ok) {
                            btnEl.closest('tr')?.remove();
                            if (!tb.querySelector('tr')) {
                                tb.innerHTML = '<tr><td colspan="4" class="text-gray-500">Пусто</td></tr>';
                            }
                        } else {
                            btnEl.disabled = false;
                            alert('Не удалось удалить');
                        }
                    };
                });
            }

            await Promise.all([loadReports(), loadMutes(), loadLogs()]);
        })();
    </script>
    <style>
        .admin-btn { font-size: 12px; padding: 4px 10px; border-radius: 8px; font-weight: 500; border: none; cursor: pointer; }
        .admin-btn.ok { background: #dcfce7; color: #166534; }
        .admin-btn.warn { background: #fef3c7; color: #92400e; }
        .admin-btn.danger { background: #fee2e2; color: #991b1b; }
        .dark .admin-btn.ok { background: rgba(22,101,52,.35); color: #86efac; }
        .dark .admin-btn.warn { background: rgba(146,64,14,.35); color: #fcd34d; }
        .dark .admin-btn.danger { background: rgba(153,27,27,.35); color: #fca5a5; }
        .admin-btn:disabled { opacity: .5; cursor: wait; }
    </style>
</body>
</html>
