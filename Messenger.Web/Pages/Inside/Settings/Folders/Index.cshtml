@page "/inside/settings/folders"
@model Messenger.Web.Pages.Inside.Settings.Folders.IndexModel
@{
    Layout = null;
    var fullName = Model.DisplayName;
    ViewData["Title"] = "Папки чатов";
}

<!DOCTYPE html>
<html lang="ru" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="access-token" content="@Model.AccessToken">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)">
    <title>@ViewData["Title"]</title>
    <script>
        (function () {
            const saved = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (saved === 'dark' || (!saved && prefersDark)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
    <partial name="_LayoutPWA" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>
    <script src="https://unpkg.com/feather-icons"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/settings-sync.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-dialogs.css" asp-append-version="true" />
</head>
<body class="flex bg-gray-50 dark:bg-gray-900">
    <div id="sidebar-overlay" class="sidebar-overlay"></div>

    <aside id="sidebar" class="sidebar">
        <div class="p-5 text-center border-b border-gray-200 dark:border-gray-700">
            <div class="guap-gradient w-11 h-11 rounded-full flex items-center justify-center mx-auto mb-2.5">
                <i data-feather="message-square" class="w-5 h-5 text-white"></i>
            </div>
            <h1 class="text-lg font-bold text-gray-800 dark:text-white">GUAP Messenger</h1>
        </div>
        <nav class="flex-1 p-3 overflow-y-auto">
            <a asp-page="/Inside/Chats/Index" class="block py-2.5 px-4 text-gray-600 dark:text-gray-300 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition">Чаты</a>
            <a href="#" class="block py-2.5 px-4 bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 rounded-xl font-medium">Настройки</a>
                                    <div class="pl-4 mt-3 space-y-0.5">
                <a asp-page="/Inside/Settings/Profile/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Профиль</a>
                <a asp-page="/Inside/Settings/Security/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Безопасность</a>
                <a asp-page="/Inside/Settings/Notifications/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Уведомления</a>
                <a asp-page="/Inside/Settings/Appearance/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Внешний вид</a>
                <a asp-page="/Inside/Settings/Folders/Index" class="sidebar-link block py-2 px-4 text-sm bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 rounded-lg font-medium">Папки чатов</a>
                <a asp-page="/Inside/Settings/Privacy/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Конфиденциальность</a>
                <a id="nav-admin-link" asp-page="/Inside/Settings/Admin/Index" class="sidebar-link hidden block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Админ-панель</a>
            </div>
        </nav>
        <div class="p-4 border-t border-gray-200 dark:border-gray-700">
            <p class="text-sm text-gray-600 dark:text-gray-400 truncate text-center">@fullName</p>
            <form asp-page="/Logout" method="post" data-logout="true" class="w-full">
                <button type="submit" class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition font-medium text-sm">
                    <i data-feather="log-out" class="w-4 h-4"></i><span>Выйти</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <div class="mobile-header">
            <button id="menu-toggle" type="button" class="w-11 h-11 flex items-center justify-center rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition" aria-label="Меню">
                <i data-feather="menu" class="w-6 h-6 text-gray-700 dark:text-gray-200"></i>
            </button>
            <h1 class="text-lg font-semibold text-gray-800 dark:text-white truncate">Папки чатов</h1>
            <div class="w-11"></div>
        </div>

        <main class="main-content p-4 sm:p-6">
            <div class="max-w-4xl mx-auto space-y-5 sm:space-y-6">
                <h2 class="text-xl sm:text-2xl font-semibold text-gray-800 dark:text-white hidden sm:block">Папки чатов</h2>

                
                <section class="settings-card">
                    <div class="settings-card-header">
                        <div class="settings-icon-wrap bg-amber-50 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400">
                            <i data-feather="folder" class="w-5 h-5"></i>
                        </div>
                        <div class="min-w-0">
                            <h3 class="settings-card-title">Папки</h3>
                            <p class="settings-card-desc">Группируйте чаты по папкам</p>
                        </div>
                    </div>
                    <div class="p-3">
                        <button type="button" id="folder-create-btn" class="w-full guap-gradient text-white py-2.5 px-4 rounded-xl font-medium hover:opacity-90 transition flex items-center justify-center gap-2">
                            <i data-feather="plus" class="w-4 h-4"></i> Создать папку
                        </button>
                    </div>
                    <div id="folders-list" class="divide-y divide-gray-100 dark:divide-gray-700"></div>
                    <p id="folders-empty" class="hidden text-center text-sm text-gray-500 dark:text-gray-400 py-6 px-4">Папок пока нет. Создайте первую.</p>
                </section>

                <!-- Modal create/edit -->
                <div id="folder-edit-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
                    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl w-full max-w-md max-h-[90vh] overflow-hidden flex flex-col">
                        <div class="px-5 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
                            <h3 id="folder-modal-title" class="font-semibold text-gray-900 dark:text-white">Новая папка</h3>
                            <button type="button" id="folder-modal-close" class="text-gray-400 hover:text-gray-600"><i data-feather="x" class="w-5 h-5"></i></button>
                        </div>
                        <div class="p-5 overflow-y-auto flex-1 space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Название</label>
                                <input type="text" id="folder-name-input" maxlength="64" placeholder="Работа, Семья…"
                                       class="w-full px-3 py-2 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Чаты в папке</label>
                                <input type="text" id="folder-chat-search" placeholder="Поиск чатов…"
                                       class="w-full px-3 py-2 mb-2 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white outline-none">
                                <div id="folder-chats-picker" class="max-h-56 overflow-y-auto space-y-1 border border-gray-100 dark:border-gray-700 rounded-xl p-2"></div>
                            </div>
                        </div>
                        <div class="px-5 py-4 border-t border-gray-200 dark:border-gray-700 flex gap-2">
                            <button type="button" id="folder-modal-cancel" class="flex-1 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-200">Отмена</button>
                            <button type="button" id="folder-modal-save" class="flex-1 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-medium">Сохранить</button>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>
<script src="~/js/ui-dialogs.js" asp-append-version="true"></script>
        <script>
        (function () {
            const sessionToken = '@(HttpContext.Session.GetString("ACCESS_TOKEN") ?? "")';
            const modelToken = '@Model.AccessToken';
            const t = (modelToken || sessionToken || localStorage.getItem('token') || '').trim();
            if (t) {
                try { localStorage.setItem('token', t.replace(/^Bearer\s+/i, '')); } catch (_) {}
            }
            window.API_BASE_URL = '@Model.ApiBaseUrl';
            if (typeof getAuthToken !== 'function') {
                window.getAuthToken = function () {
                    const raw = (localStorage.getItem('token') || modelToken || sessionToken || '').trim();
                    if (!raw) return '';
                    return raw.startsWith('Bearer ') ? raw : ('Bearer ' + raw);
                };
            }
        })();
    </script>
    <script src="~/js/settings-folders.js" asp-append-version="true"></script>
    <script src="~/js/settings-prefs.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof feather !== 'undefined') feather.replace();
            if (typeof initPrefToggles === 'function') initPrefToggles();
            if (window.SettingsFolders) SettingsFolders.init();
            if (typeof initThemePicker === 'function') initThemePicker();
        });
    </script>

    <script>
    (function () {
        const link = document.getElementById('nav-admin-link');
        if (!link) return;
        const API = (typeof window.API_BASE_URL === 'string' && window.API_BASE_URL
            ? window.API_BASE_URL
            : '@Model.ApiBaseUrl').replace(/\/$/, '');
        let t = document.querySelector('meta[name="access-token"]')?.content || '';
        try { t = t || localStorage.getItem('token') || ''; } catch (_) {}
        t = String(t).replace(/^Bearer\s+/i, '');
        const headers = t ? { 'Authorization': 'Bearer ' + t } : {};
        fetch(API + '/admin/me', { headers, credentials: 'include' })
            .then(r => r.ok ? r.json() : null)
            .then(j => { if (j && (j.isAdmin === true || j.IsAdmin === true)) link.classList.remove('hidden'); })
            .catch(() => {});
    })();
    </script>

</body>
</html>