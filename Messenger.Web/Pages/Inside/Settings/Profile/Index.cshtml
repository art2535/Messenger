@page "/inside/settings/profile"
@model Messenger.Web.Pages.Inside.Settings.Profile.IndexModel
@{
    Layout = null;
    var hasAvatar = Model.HasAvatar;
    var avatarUrl = Model.AvatarUrl;
    var lastName = Model.Profile.LastName;
    var firstName = Model.Profile.FirstName;
    var fullName = $"{lastName} {firstName}";
    ViewData["Title"] = "Настройки аккаунта";
}

<!DOCTYPE html>
<html lang="ru" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)">
    <meta name="access-token" content="@Model.AccessToken">
    <meta name="api-base" content="@Model.ApiBaseUrl">
    <title>@ViewData["Title"]</title>

    <script>
        (function () {
            const saved = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (saved === 'dark' || (!saved && prefersDark)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    <partial name="_LayoutPWA" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
            tailwind.config = { darkMode: 'class' }
    </script>
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/settings-sync.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-dialogs.css" asp-append-version="true" />

</head>
<body class="flex bg-gray-50 dark:bg-gray-900">
    <div id="sidebar-overlay" class="sidebar-overlay"></div>

    <aside id="sidebar" class="sidebar">
        <div class="p-5 text-center border-b border-gray-200 dark:border-gray-700">
            <div class="guap-gradient w-11 h-11 rounded-full flex items-center justify-center mx-auto mb-2.5">
                <i data-feather="message-square" class="w-5 h-5 text-white"></i>
            </div>
            <h1 class="text-lg font-bold text-gray-800 dark:text-white">GUAP Messenger</h1>
        </div>

        <nav class="flex-1 p-3 overflow-y-auto">
            <a asp-page="/Inside/Chats/Index"  
               class="block py-2.5 px-4 text-gray-600 dark:text-gray-300 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition active:scale-[0.98]">
                Чаты
            </a>
            <a href="#" class="block py-2.5 px-4 bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 rounded-xl font-medium">
                Настройки
            </a>

            <div class="pl-4 mt-3 space-y-0.5">
                <a asp-page="/Inside/Settings/Profile/Index" class="sidebar-link block py-2 px-4 text-sm bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 rounded-lg font-medium">
                    Профиль
                </a>
                <a asp-page="/Inside/Settings/Security/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    Безопасность
                </a>
                <a asp-page="/Inside/Settings/Notifications/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    Уведомления
                </a>
                <a asp-page="/Inside/Settings/Appearance/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    Внешний вид
                </a>
                <a asp-page="/Inside/Settings/Privacy/Index" class="sidebar-link block py-2 px-4 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    Конфиденциальность
                </a>
            </div>
        </nav>

        <div class="p-4 border-t border-gray-200 dark:border-gray-700 space-y-3">
            <p class="text-sm text-gray-600 dark:text-gray-400 truncate text-center">@fullName</p>
            <form asp-page="/Logout" method="post" data-logout="true" class="w-full">
                <button type="submit"
                        class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition active:scale-[0.98] font-medium text-sm"
                        title="Выйти из аккаунта">
                    <i data-feather="log-out" class="w-4 h-4"></i>
                    <span>Выйти</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <div class="mobile-header">
            <button id="menu-toggle" type="button"
                    class="w-11 h-11 flex items-center justify-center rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700 transition"
                    aria-label="Открыть меню">
                <i data-feather="menu" class="w-6 h-6 text-gray-700 dark:text-gray-200"></i>
            </button>
            <h1 class="text-lg font-semibold text-gray-800 dark:text-white truncate">Настройки</h1>
            <div class="w-11"></div>
        </div>

        <main class="main-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <script>
                    window.__profileJustSaved = true;
                    window.__savedAvatarUrl = @Html.Raw(hasAvatar && !string.IsNullOrEmpty(avatarUrl)
                                            ? $"'{avatarUrl.Replace("'", "\\'")}'"
                                            : "null");
                    window.__savedDisplayName = @Html.Raw($"'{fullName.Replace("'", "\\'")}'");
                    document.addEventListener('DOMContentLoaded', () => {
                        showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]?.ToString() ?? "")), 'success');
                    });
                </script>
            }

            <div class="max-w-4xl mx-auto px-2 sm:px-0">
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-800 dark:text-white mb-6 sm:mb-8 hidden sm:block">
                    Настройки аккаунта
                </h2>
            </div>

            <form method="post" enctype="multipart/form-data" asp-page-handler="Save" class="max-w-4xl mx-auto space-y-6 sm:space-y-8">

                <section id="profile" class="bg-white dark:bg-gray-800 rounded-2xl shadow-md p-5 sm:p-8">
                    <h3 class="text-xl sm:text-2xl font-semibold text-gray-800 dark:text-white mb-6 sm:mb-8">Профиль</h3>

                    <div class="flex flex-col md:flex-row gap-8 md:gap-10 items-start">
                        <div class="flex flex-col items-center space-y-4 w-full md:w-auto">
                            <div class="relative w-36 h-36 sm:w-40 sm:h-40">
                                @if (hasAvatar && !string.IsNullOrEmpty(avatarUrl))
                                {
                                    <img id="current-avatar"
                                         src="@avatarUrl?t=@DateTimeOffset.UtcNow.ToUnixTimeSeconds()"
                                         alt="Аватар"
                                         class="w-36 h-36 sm:w-40 sm:h-40 rounded-full object-cover border-4 border-gray-200 dark:border-gray-600 shadow-xl relative z-10"
                                         referrerpolicy="no-referrer"
                                         style="display:block;"
                                         onerror="this.remove(); var d=document.getElementById('default-avatar'); if(d){ d.classList.remove('hidden'); d.style.display='flex'; }">
                                    <div id="default-avatar"
                                         class="hidden avatar-placeholder-user w-36 h-36 sm:w-40 sm:h-40 rounded-full items-center justify-center shadow-xl absolute inset-0 z-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white opacity-90"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    </div>
                                }
                                else
                                {
                                    <div id="current-avatar" class="avatar-placeholder-user w-36 h-36 sm:w-40 sm:h-40 rounded-full flex items-center justify-center shadow-xl relative z-10">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white opacity-90"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    </div>
                                    <div id="default-avatar" class="hidden"></div>
                                }

                                <div id="avatar-preview-container" class="hidden absolute inset-0 rounded-full overflow-hidden border-4 border-blue-500 shadow-2xl z-20 pointer-events-none" style="background:#e5e7eb;">
                                    <img id="avatar-preview" src="" alt="Предпросмотр" class="w-full h-full object-cover" style="display:block;">
                                </div>
                            </div>

                            <div class="flex flex-col space-y-2.5 w-full max-w-xs">
                                <input type="file" id="avatarInput" name="AvatarFile" accept="image/*" class="hidden">
                                <label for="avatarInput"
                                       class="guap-gradient text-white py-3 px-6 rounded-xl hover:opacity-90 active:scale-[0.98] cursor-pointer font-medium text-center transition text-sm sm:text-base">
                                    Изменить фото
                                </label>
                                <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 text-center">
                                    JPG, PNG, GIF, WEBP · до 2 МБ
                                </p>
                                <button type="button" id="cancel-preview"
                                        class="text-sm text-gray-600 dark:text-gray-400 hover:underline hidden py-1">
                                    Отменить выбор
                                </button>
                                <button type="button" id="delete-avatar-trigger"
                                        class="text-sm text-red-600 hover:text-red-800 hover:underline py-1 @(hasAvatar ? "" : "hidden")">
                                    Удалить фото
                                </button>
                            </div>
                            <input type="hidden" name="DeleteAvatar" id="delete-avatar-flag" value="false" />
                        </div>

                        <div class="flex-1 space-y-5 w-full">
                            <div class="grid sm:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Фамилия</label>
                                    <input asp-for="Profile.LastName" class="input-field" readonly>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Имя</label>
                                    <input asp-for="Profile.FirstName" class="input-field" readonly>
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Логин (email)</label>
                                <input asp-for="Profile.Login" type="email" class="input-field" readonly>
                            </div>
                        </div>
                    </div>
                </section>


                <div class="form-actions flex justify-end gap-3 sm:gap-4 py-4 sm:py-6">
                    <button type="button" onclick="history.back()"
                            class="px-6 py-3.5 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-xl hover:bg-gray-300 dark:hover:bg-gray-600 font-medium active:scale-[0.98] transition">
                        Отмена
                    </button>
                    <button type="submit"
                            class="px-8 py-3.5 guap-gradient text-white rounded-xl hover:opacity-90 font-medium active:scale-[0.98] transition">
                        Сохранить изменения
                    </button>
                </div>
            </form>
        </main>
    </div>

    <div id="toast-container"></div>

    <div id="confirmModal" class="modal-overlay">
        <div class="modal-content p-6 sm:p-8 text-center">
            <h3 class="text-lg sm:text-xl font-semibold mb-3" id="confirmTitle">Подтвердите действие</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-6 sm:mb-8 text-sm sm:text-base" id="confirmMessage"></p>
            <div class="flex flex-col-reverse sm:flex-row justify-center gap-3">
                <button onclick="closeConfirm(false)"
                        class="px-6 py-3 bg-gray-200 dark:bg-gray-600 rounded-xl hover:bg-gray-300 dark:hover:bg-gray-500 font-medium">
                    Отмена
                </button>
                <button id="confirmYesBtn"
                        class="px-6 py-3 guap-gradient text-white rounded-xl hover:opacity-90 font-medium">
                    Подтвердить
                </button>
            </div>
        </div>
    </div>


    <script>
        const sessionToken = '@(HttpContext.Session.GetString("ACCESS_TOKEN") ?? "")';
        const modelToken = '@Model.AccessToken';
        (function persistToken() {
            const t = (modelToken || sessionToken || localStorage.getItem('token') || '').trim();
            if (t) {
                try { localStorage.setItem('token', t.replace(/^Bearer\s+/i, '')); } catch (_) {}
            }
        })();
        const isAuthenticated = @User.Identity?.IsAuthenticated.ToString().ToLower();
        const hasClientToken = !!(localStorage.getItem('token') || sessionToken || modelToken);
        if (!isAuthenticated && !hasClientToken) {
            console.warn("Settings: Неавторизованный доступ - редирект");
            window.location.href = "/login";
        }
        function getAuthToken() {
            const raw = (modelToken || localStorage.getItem('token') || sessionToken || '').trim();
            if (!raw) return '';
            return raw.startsWith('Bearer ') ? raw : raw;
        }
        window.API_BASE_URL = '@Model.ApiBaseUrl';
        window.HUB_URL = '@Model.HubUrl';
    </script>
    <script src="~/js/ui-dialogs.js" asp-append-version="true"></script>
    <script src="~/app.js"></script>
    <script src="~/js/session-cleanup.js"></script>
    <script src="~/js/settings.js" asp-append-version="true"></script>
</body>
</html>